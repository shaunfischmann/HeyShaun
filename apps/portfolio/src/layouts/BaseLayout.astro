---
import "../styles/global.css";
import "@heyshaun/design-tokens/colors.css";
import type { Lang } from "../i18n/utils";

export interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  isGallery?: boolean;
}

const {
  lang = "en",
  title = "Shaun Fischmann — Partnership Manager & Web Developer",
  description = "Technical Partnership Manager and Senior Web Developer with 12+ years of experience in Proptech, enterprise real estate CRMs, API integrations, and SQL architecture.",
  image = "/og-image.jpg",
  currentPath = "/",
  isGallery = false,
} = Astro.props;

const SITE = "https://heyshaun.fr";
const ogLocale = lang === "fr" ? "fr_FR" : "en_US";
const ogLocaleAlt = lang === "fr" ? "en_US" : "fr_FR";

// Canonical: always points to the current lang page
const canonicalURL = `${SITE}/${lang}${currentPath === "/" ? "" : currentPath}`;

// hreflang alternates
const hreflangEn = `${SITE}/en${currentPath === "/" ? "" : currentPath}`;
const hreflangFr = `${SITE}/fr${currentPath === "/" ? "" : currentPath}`;
const ogImageURL = `${SITE}${image}`;

// --- Dynamic Schema.org graph ---
const personEntity = {
  "@type": "Person",
  name: "Shaun Fischmann",
  givenName: "Shaun",
  familyName: "Fischmann",
  jobTitle: "Partnership Manager & Web Developer",
  description:
    "Partnership Manager and Senior web developer with 12+ years of experience specializing in PHP, enterprise real estate CRMs, REST API integrations, SQL, Proptech and generative AI.",
  url: SITE,
  image: ogImageURL,
  sameAs: ["https://www.linkedin.com/in/sfischmann/", "https://github.com/shaunfischmann"],
  address: { "@type": "PostalAddress", addressCountry: "FR" },
  worksFor: { "@type": "Organization", name: "Apimo", url: "https://www.apimo.pro" },
  knowsAbout: [
    "Technical Partnership Management",
    "API Integrations & Webhooks",
    "PHP 7+",
    "PHP 8+",
    "Symfony",
    "Propel ORM",
    "MySQL/MariaDB",
    "RESTful API Design",
    "Astro Web Framework",
    "Generative AI",
    "JavaScript",
    "Web Performance",
  ],
  hasOccupation: [
    {
      "@type": "Occupation",
      name: "Partnership Manager",
      skills: "Technical Integrations, Partner Relations, API Strategy, Solution Architecture",
      occupationLocation: { "@type": "Country", name: "France" },
    },
    {
      "@type": "Occupation",
      name: "Senior Web Developer",
      skills: "PHP, Enterprise CRM Architecture, MySQL, REST APIs, JavaScript, HTML, CSS",
      occupationLocation: { "@type": "Country", name: "France" },
    },
  ],
};

const schemaGraph: object[] = [
  {
    "@type": "ProfilePage",
    name: "Shaun Fischmann — Partnership Manager & Senior Developer",
    description: description,
    url: canonicalURL,
    mainEntity: personEntity,
  },
  {
    "@type": "WebSite",
    url: SITE,
    name: "Shaun Fischmann — Portfolio",
    description:
      "Personal portfolio showcasing technical partnerships, web development projects, PHP expertise, and generative AI art.",
    author: { "@type": "Person", name: "Shaun Fischmann" },
  },
];

if (isGallery) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: lang === "fr" ? "Accueil" : "Home", item: `${SITE}/${lang}/` },
      { "@type": "ListItem", position: 2, name: lang === "fr" ? "Galerie IA" : "AI Gallery", item: canonicalURL },
    ],
  });
}

const schemaData = { "@context": "https://schema.org", "@graph": schemaGraph };
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Essential Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Shaun Fischmann" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates for multilingual SEO -->
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="fr" href={hreflangFr} />
    <link rel="alternate" hreflang="x-default" href={hreflangEn} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:site_name" content="Shaun Fischmann" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon & Assets -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&family=Fira+Code:wght@400&display=swap"
    />

    <!-- Keywords (semantic crawlers) -->
    <meta
      name="keywords"
      content="Shaun Fischmann, Technical Partnership Manager, Partner Engineer, PHP Developer, Senior Web Developer, Real Estate CRM, SQL database architecture, MySQL, REST APIs, PHP, Symfony, Proptech, Astro, Full Stack Web Development, AI art, Midjourney, Stable Diffusion, France, portfolio"
    />

    <!-- Schema.org Comprehensive Graph -->
    <script type="application/ld+json" set:text={JSON.stringify(schemaData)} />
  </head>

  <body>
    <!-- Ambient Parallax Orbs -->
    <div class="ambient-bg" aria-hidden="true" id="ambient-bg">
      <div class="ambient-orb orb-1" data-parallax-speed="0.25"></div>
      <div class="ambient-orb orb-2" data-parallax-speed="-0.35"></div>
      <div class="ambient-orb orb-3" data-parallax-speed="0.15"></div>
      <div class="ambient-orb orb-4" data-parallax-speed="-0.2"></div>
      <div class="ambient-grid" data-parallax-speed="0.08"></div>
    </div>

    <slot />

    <!-- Scroll reveal observer & Background Parallax script -->
    <script>
      // 1. Universal Scroll Reveal Observer
      //    Handles all [data-reveal] variants including clip, slide, pop, scale
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
      );

      // Observe all reveal elements
      document.querySelectorAll("[data-reveal]").forEach((el) => {
        revealObserver.observe(el);
      });

      // 2. High-Performance Background Parallax
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!prefersReducedMotion) {
        const parallaxElements = document.querySelectorAll<HTMLElement>("[data-parallax-speed]");
        let ticking = false;

        function updateBackgroundParallax() {
          const scrollY = window.scrollY;
          parallaxElements.forEach((el) => {
            const speed = parseFloat(el.getAttribute("data-parallax-speed") || "0.1");
            el.style.transform = `translate3d(0, ${(scrollY * speed).toFixed(2)}px, 0)`;
          });
          ticking = false;
        }

        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              window.requestAnimationFrame(updateBackgroundParallax);
              ticking = true;
            }
          },
          { passive: true },
        );

        updateBackgroundParallax();
      }
    </script>
  </body>
</html>

<!-- Global styles imported in frontmatter via Astro's native import -->
