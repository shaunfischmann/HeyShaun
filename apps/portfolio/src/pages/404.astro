---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Contact from "../components/sections/Contact.astro";
import { getTranslations } from "../i18n/utils";
import { Home, Palette } from "@lucide/astro";

// Default fallback language is "en"
const lang = "en";
const t = getTranslations(lang);
---

<BaseLayout
  lang={lang}
  title="404 Page Not Found — Shaun Fischmann"
  description="The page you are looking for does not exist."
  currentPath="/404"
>
  <Nav lang={lang} isHomepage={false} currentPath="/404" />

  <main id="main-content" class="not-found-container">
    <div class="container">
      <div class="not-found-card glass-card">
        <div class="glitch-wrapper">
          <h1 class="glitch-code gradient-text" data-text="404">404</h1>
        </div>

        <h2 class="error-heading" id="404-heading">{t.not_found?.heading || "Lost in Cyberspace"}</h2>
        <p class="error-sub" id="404-sub">
          {
            t.not_found?.sub ||
              "The page you are looking for doesn't exist, was removed, or is temporarily unavailable."
          }
        </p>

        <div class="cta-group">
          <a href="/en/" id="404-home-btn" class="cta-btn primary-btn glass-card">
            <Home size={18} stroke-width={2} />
            <span id="404-home-text">{t.not_found?.cta_home || "Return to Homepage"}</span>
          </a>
          <a href="/en/shaun-ai-gallery" id="404-gallery-btn" class="cta-btn secondary-btn glass-card">
            <Palette size={18} stroke-width={2} />
            <span id="404-gallery-text">{t.not_found?.cta_gallery || "Explore AI Gallery"}</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Contact lang={lang} t={t} />
</BaseLayout>

<script is:inline>
  // Client-side language adaptation for fallback 404 page
  const path = window.location.pathname || "";
  const isFrenchPath = path.startsWith("/fr/") || path === "/fr";
  const isEnglishPath = path.startsWith("/en/") || path === "/en";
  const prefersFrench =
    isFrenchPath ||
    (!isEnglishPath && (navigator.languages || [navigator.language]).some((l) => l && l.toString().startsWith("fr")));

  if (prefersFrench) {
    const heading = document.getElementById("404-heading");
    const sub = document.getElementById("404-sub");
    const homeBtn = document.getElementById("404-home-btn");
    const homeText = document.getElementById("404-home-text");
    const galleryBtn = document.getElementById("404-gallery-btn");
    const galleryText = document.getElementById("404-gallery-text");

    if (heading) heading.textContent = "Perdu dans le Cyberespace";
    if (sub)
      sub.textContent = "La page que vous recherchez n'existe pas, a été supprimée ou est temporairement indisponible.";
    if (homeBtn) homeBtn.setAttribute("href", "/fr/");
    if (homeText) homeText.textContent = "Retour à l'accueil";
    if (galleryBtn) galleryBtn.setAttribute("href", "/fr/shaun-ai-gallery");
    if (galleryText) galleryText.textContent = "Explorer la Galerie IA";
  }
</script>

<style>
  .not-found-container {
    padding-top: clamp(7rem, 14vw, 10rem);
    padding-bottom: 5rem;
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-card {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .glitch-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 0.25rem;
  }

  .glitch-code {
    position: relative;
    font-family: var(--font-heading);
    font-size: clamp(5.5rem, 16vw, 9.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
    display: inline-block;
    user-select: none;
  }

  .glitch-code::before,
  .glitch-code::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: inherit;
    background-clip: text;
    opacity: 0.8;
    pointer-events: none;
  }

  .glitch-code::before {
    left: 3px;
    text-shadow: -2px 0 var(--color-secondary);
    animation: glitch-anim-1 2.5s infinite linear alternate-reverse;
  }

  .glitch-code::after {
    left: -3px;
    text-shadow: -2px 0 var(--color-primary);
    animation: glitch-anim-2 3.2s infinite linear alternate-reverse;
  }

  @keyframes glitch-anim-1 {
    0% {
      clip-path: inset(15% 0 65% 0);
    }
    15% {
      clip-path: inset(55% 0 10% 0);
    }
    30% {
      clip-path: inset(35% 0 45% 0);
    }
    45% {
      clip-path: inset(80% 0 5% 0);
    }
    60% {
      clip-path: inset(10% 0 70% 0);
    }
    75% {
      clip-path: inset(40% 0 30% 0);
    }
    90% {
      clip-path: inset(65% 0 15% 0);
    }
    100% {
      clip-path: inset(25% 0 50% 0);
    }
  }

  @keyframes glitch-anim-2 {
    0% {
      clip-path: inset(70% 0 10% 0);
    }
    15% {
      clip-path: inset(20% 0 60% 0);
    }
    30% {
      clip-path: inset(45% 0 35% 0);
    }
    45% {
      clip-path: inset(10% 0 75% 0);
    }
    60% {
      clip-path: inset(60% 0 20% 0);
    }
    75% {
      clip-path: inset(30% 0 50% 0);
    }
    90% {
      clip-path: inset(5% 0 85% 0);
    }
    100% {
      clip-path: inset(50% 0 25% 0);
    }
  }

  .error-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text);
  }

  .error-sub {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--color-text-muted);
    max-width: 500px;
    line-height: 1.6;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    width: 100%;

    @media (--sm) {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);

    @media (--sm) {
      width: auto;
    }
  }

  .primary-btn {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: #ffffff;
    border: none;
    box-shadow: 0 10px 25px -5px var(--glow-primary);
  }

  .primary-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px -5px var(--glow-secondary);
  }

  .secondary-btn {
    color: var(--color-text);
  }

  .secondary-btn:hover {
    transform: translateY(-3px);
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }
</style>
