---
// Root redirect — detects browser language and sends to /en/ or /fr/
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shaun Fischmann</title>
    <!-- No-JS fallback: redirect to /en/ -->
    <meta http-equiv="refresh" content="0;url=/en/" />
    <link rel="canonical" href="https://heyshaun.fr/en/" />
    <!-- hreflang for crawlers -->
    <link rel="alternate" hreflang="en" href="https://heyshaun.fr/en/" />
    <link rel="alternate" hreflang="fr" href="https://heyshaun.fr/fr/" />
    <link rel="alternate" hreflang="x-default" href="https://heyshaun.fr/en/" />
  </head>
  <body>
    <script is:inline>
      // Detect browser language preference; redirect to /fr/ for French browsers
      const prefersFrench = (navigator.languages || [navigator.language]).some(
        (l) => l && l.toString().startsWith("fr"),
      );
      window.location.replace(prefersFrench ? "/fr/" : "/en/");
    </script>
  </body>
</html>
