---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import AiArt from "../../components/sections/AiArt.astro";
import Contact from "../../components/sections/Contact.astro";
import { LANGS, getTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslations(lang);
---

<BaseLayout lang={lang} title={t.seo.gallery_title} description={t.seo.gallery_description} currentPath="/shaun-ai-gallery" isGallery={true}>
  <Nav lang={lang} isHomepage={false} currentPath="/shaun-ai-gallery" />
  <main id="main-content">
    <AiArt isHomepage={false} lang={lang} t={t} />
    <Contact lang={lang} t={t} />
  </main>
</BaseLayout>
