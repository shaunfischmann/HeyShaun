---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Contact from "../../components/sections/Contact.astro";
import { LANGS, getTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import { ArrowLeft, Code2, Cpu, Sparkles } from "@lucide/astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t.credits_page?.title || "Credits — Shaun Fischmann"}
  description={t.credits_page?.description ||
    "Credits, open-source libraries, and design acknowledgments for Shaun Fischmann's portfolio."}
  currentPath="/credits"
>
  <Nav lang={lang} isHomepage={false} currentPath="/credits" />

  <main id="main-content" class="legal-page-container">
    <div class="container">
      <div class="legal-header section-header">
        <a href={`/${lang}/`} class="back-link glass-card">
          <ArrowLeft size={16} stroke-width={2} />
          <span>{t.credits_page?.back_home || (lang === "fr" ? "Retour à l'accueil" : "Back to Home")}</span>
        </a>
        <h1 class="page-title gradient-text">{t.credits_page?.heading || "Credits & Acknowledgments"}</h1>
        <p class="page-sub">
          {t.credits_page?.sub || "Open-source libraries, design inspiration, and tools behind this portfolio."}
        </p>
      </div>

      <!-- Content Grid -->
      <div class="legal-grid">
        <!-- 1. Open Source Libraries & Frameworks -->
        <div class="legal-card glass-card">
          <div class="card-icon-header">
            <div class="card-icon-badge">
              <Code2 size={22} color="currentColor" stroke-width={2} />
            </div>
            <h2>{t.credits_page?.section_oss_title || "Open Source Libraries & Frameworks"}</h2>
          </div>
          <div class="card-content" set:html={t.credits_page?.section_oss_desc} />
        </div>

        <!-- 2. Tools & AI -->
        <div class="legal-card glass-card">
          <div class="card-icon-header">
            <div class="card-icon-badge">
              <Cpu size={22} color="currentColor" stroke-width={2} />
            </div>
            <h2>{t.credits_page?.section_tools_title || "Tools & AI"}</h2>
          </div>
          <div class="card-content" set:html={t.credits_page?.section_tools_desc} />
        </div>

        <!-- 3. Design & Inspiration -->
        <div class="legal-card glass-card">
          <div class="card-icon-header">
            <div class="card-icon-badge">
              <Sparkles size={22} color="currentColor" stroke-width={2} />
            </div>
            <h2>{t.credits_page?.section_design_title || "Design & Inspiration"}</h2>
          </div>
          <div class="card-content" set:html={t.credits_page?.section_design_desc} />
        </div>
      </div>
    </div>
  </main>

  <Contact lang={lang} t={t} />
</BaseLayout>

<style>
  .legal-page-container {
    padding-top: var(--section-padding);
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .page-sub {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-muted);
    max-width: 650px;
    line-height: 1.6;
  }

  /* Grid Layout */
  .legal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;

    @media (--sm) {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .legal-card {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition:
      transform var(--transition-base),
      border-color var(--transition-base);

    @media (--sm) {
      padding: 2rem;
    }
  }

  .legal-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
  }

  .card-icon-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(108, 92, 231, 0.15), rgba(0, 206, 201, 0.15));
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .card-icon-header h2 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .card-content {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .card-content :global(a.legal-link),
  .card-content :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .card-content :global(a:hover) {
    color: var(--color-primary);
  }

  .card-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
