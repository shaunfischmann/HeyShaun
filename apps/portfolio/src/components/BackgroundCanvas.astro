---
// BackgroundCanvas.astro
---

<div id="canvas-bg">
  <canvas id="astro-bg-canvas"></canvas>
</div>

<style>
  #canvas-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -100;
    pointer-events: none;
  }

  #astro-bg-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // =========================================================================
  // EASY CONFIGURATION SETTINGS
  // Adjust these values to tweak the visuals without touching the animation code!
  // =========================================================================
  const CONFIG = {
    // PERFORMANCE SETTINGS
    performance: {
      disableStarAnimations: false, // Set to true to disable star mouse interaction (saves 2-3% CPU)
      maxShootingStars: 2, // Reduce concurrent shooting stars for better perf
    },

    // 1. GRID SETTINGS (Light Mode Only)
    grid: {
      spacing: 24, // Distance between grid dots in px (lower = denser grid)
      dotSize: 2, // Size of grid dots in px

      // Light Mode Grid Visibility
      lightColor: "30, 41, 59", // Slate color (RGB)
      lightOpacityBase: 0.18, // Base opacity
      lightOpacityMultiplier: 1.2, // Overall boost for light mode grid
      parallaxSpeed: 0.04, // Grid parallax scroll speed
    },

    // 2. STARDUST / STARS SETTINGS (Dark Mode Only)
    stars: {
      densityDivider: 2200, // Lower = MORE stars (e.g., 1000 = dense, 3000 = sparse)
      color: "245, 235, 224", // Warm white / lavender (RGB)
      sizeMin: 0.9, // Minimum star pixel size
      sizeMax: 2.2, // Maximum star pixel size

      // Star Opacity Boost
      opacityMin: 0.25, // Minimum opacity
      opacityMax: 0.75, // Maximum opacity

      // Star Parallax Settings
      parallaxSpeedMin: 0.02, // Slowest (distant background) star scroll speed
      parallaxSpeedMax: 0.14, // Fastest (foreground) star scroll speed
      mouseParallaxFactor: 0.035, // Subtle mouse tilt depth factor
    },

    // 3. SHOOTING STARS SETTINGS (Dark Mode Only)
    shootingStars: {
      enabled: true,
      spawnProbability: 0.0075, // Chance per frame (roughly every 3-5 seconds)
      color: "255, 255, 255", // Color (RGB)
      speedMin: 8, // Minimum flight speed (px per frame)
      speedMax: 15, // Maximum flight speed
      lengthMin: 40, // Minimum tail length in px
      lengthMax: 90, // Maximum tail length in px
    },
  };

  // =========================================================================
  // INTERFACES & TYPES
  // =========================================================================
  interface GridDot {
    baseX: number;
    baseY: number;
    size: number;
    baseOpacity: number;
  }

  interface StarParticle {
    baseX: number;
    baseY: number;
    size: number;
    opacity: number;
    speed: number;
    twinkleSpeed: number;
    twinklePhase: number;
  }

  interface ShootingStar {
    x: number;
    y: number;
    length: number;
    speed: number;
    angle: number;
    opacity: number;
    dx: number;
    dy: number;
  }

  // =========================================================================
  // MAIN ANIMATION CLASS
  // =========================================================================
  class UnifiedBackground {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private gridDots: GridDot[] = [];
    private stars: StarParticle[] = [];
    private activeShootingStars: ShootingStar[] = [];

    private mouse = { x: -1000, y: -1000, targetX: -1000, targetY: -1000 };
    private scrollY = 0;
    private targetScrollY = 0;
    private isDarkMode = false;
    private dpr = 1;
    private time = 0;
    private animationFrameId: number | null = null;
    private observer: MutationObserver | null = null;

    // Footer waves occlusion tracking
    private wavesEl: HTMLElement | null = null;
    private wavesTop = 99999;
    private currentWavesTop = 99999;

    // Cached viewport dimensions — updated only on resize, never read inside animate()
    private vw = 0;
    private vh = 0;

    // Performance guards
    private prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    private isMobile = window.innerWidth <= 768;

    constructor(canvasId: string) {
      this.canvas = document.getElementById(canvasId) as HTMLCanvasElement;
      this.ctx = this.canvas.getContext("2d", { alpha: true })!;

      this.checkTheme();
      this.findWavesElement();
      this.resize();
      this.bindEvents();
      this.animate();
    }

    private checkTheme() {
      const themeAttr = document.documentElement.getAttribute("data-theme");
      if (themeAttr) {
        this.isDarkMode = themeAttr === "dark";
      } else {
        this.isDarkMode = !window.matchMedia("(prefers-color-scheme: light)").matches;
      }
    }

    private findWavesElement() {
      this.wavesEl =
        document.querySelector(".waves-parallax") ||
        document.querySelector(".waves-container") ||
        document.querySelector(".site-footer") ||
        document.querySelector("footer");
      this.updateWavesPosition();
    }

    private updateWavesPosition() {
      if (this.wavesEl) {
        const rect = this.wavesEl.getBoundingClientRect();
        this.wavesTop = rect.top;
      } else {
        this.wavesEl =
          document.querySelector(".waves-parallax") ||
          document.querySelector(".waves-container") ||
          document.querySelector(".site-footer") ||
          document.querySelector("footer");
        if (this.wavesEl) {
          this.wavesTop = this.wavesEl.getBoundingClientRect().top;
        } else {
          this.wavesTop = 99999;
        }
      }
    }

    private resize = () => {
      const newVw = window.innerWidth;
      const newVh = window.innerHeight;

      // On mobile, scrolling down toggles the address bar (small vertical change).
      // Ignore this to prevent particles resetting or canvas flickering.
      if (this.isMobile && newVw === this.vw && Math.abs(newVh - this.vh) < 140) {
        return;
      }

      this.dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      // Cache viewport dims here so animate() never reads layout
      this.vw = newVw;
      this.vh = newVh;
      this.isMobile = this.vw <= 768;

      this.canvas.width = this.vw * this.dpr;
      this.canvas.height = this.vh * this.dpr;
      this.canvas.style.width = `${this.vw}px`;
      this.canvas.style.height = `${this.vh}px`;

      this.ctx.scale(this.dpr, this.dpr);

      this.initParticles();
      this.updateWavesPosition();
    };

    private initParticles() {
      const width = this.vw;
      const height = this.vh;

      // --- 1. Grid Dither Initialization ---
      this.gridDots = [];

      if (!this.isDarkMode && !this.prefersReducedMotion) {
        const buffer = 100;
        // On mobile, double the spacing to halve draw call count
        const spacing = this.isMobile ? CONFIG.grid.spacing * 2 : CONFIG.grid.spacing;

        for (let x = -buffer; x < width + buffer; x += spacing) {
          for (let y = -buffer; y < height + buffer; y += spacing) {
            this.gridDots.push({
              baseX: x,
              baseY: y,
              size: CONFIG.grid.dotSize,
              baseOpacity: Math.random() * 0.15 + CONFIG.grid.lightOpacityBase,
            });
          }
        }
      }

      // --- 2. Stars Initialization (Dark Mode Only) ---
      this.stars = [];
      this.activeShootingStars = [];

      if (this.isDarkMode && !this.prefersReducedMotion) {
        const totalStars = Math.floor((width * height) / CONFIG.stars.densityDivider);

        for (let i = 0; i < totalStars; i++) {
          const x = Math.random() * width;
          const y = Math.random() * height;
          const depth = Math.random(); // 0 (far) to 1 (close)

          // Closer stars are slightly larger, brighter, and move faster
          const size = CONFIG.stars.sizeMin + depth * (CONFIG.stars.sizeMax - CONFIG.stars.sizeMin);
          const opacity = CONFIG.stars.opacityMin + depth * (CONFIG.stars.opacityMax - CONFIG.stars.opacityMin);
          const speed =
            CONFIG.stars.parallaxSpeedMin + depth * (CONFIG.stars.parallaxSpeedMax - CONFIG.stars.parallaxSpeedMin);

          this.stars.push({
            baseX: x,
            baseY: y,
            size,
            opacity,
            speed,
            twinkleSpeed: 0.012 + Math.random() * 0.025,
            twinklePhase: Math.random() * Math.PI * 2,
          });
        }
      }
    }

    private spawnShootingStar() {
      const width = window.innerWidth;
      const height = window.innerHeight;

      // Spawn near top or top-right of screen
      const startX = Math.random() * width * 1.2 - width * 0.1;
      const startY = Math.random() * (height * 0.4);

      // Angle: slanted downwards (around 30-45 degrees)
      const angle = (Math.random() * 15 + 30) * (Math.PI / 180);
      const speed =
        Math.random() * (CONFIG.shootingStars.speedMax - CONFIG.shootingStars.speedMin) + CONFIG.shootingStars.speedMin;

      this.activeShootingStars.push({
        x: startX,
        y: startY,
        length:
          Math.random() * (CONFIG.shootingStars.lengthMax - CONFIG.shootingStars.lengthMin) +
          CONFIG.shootingStars.lengthMin,
        speed,
        angle,
        opacity: Math.random() * 0.5 + 0.5,
        dx: Math.cos(angle) * speed,
        dy: Math.sin(angle) * speed,
      });
    }

    private bindEvents() {
      window.addEventListener("resize", () => {
        this.resize();
        this.updateWavesPosition();
      });

      window.addEventListener("mousemove", (e) => {
        this.mouse.targetX = e.clientX;
        this.mouse.targetY = e.clientY;
      });

      // passive: true — scroll listener must never call preventDefault()
      window.addEventListener(
        "scroll",
        () => {
          this.targetScrollY = window.scrollY;
          this.updateWavesPosition();
        },
        { passive: true },
      );

      this.observer = new MutationObserver(() => {
        const wasDark = this.isDarkMode;
        this.checkTheme();
        if (wasDark !== this.isDarkMode) {
          this.initParticles();
        }
      });

      this.observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme", "class"],
      });
    }

    private animate = () => {
      this.time += 1;

      // Smooth lerp for mouse, scroll, and footer wave threshold
      this.mouse.x += (this.mouse.targetX - this.mouse.x) * 0.08;
      this.mouse.y += (this.mouse.targetY - this.mouse.y) * 0.08;
      this.scrollY += (this.targetScrollY - this.scrollY) * 0.08;
      this.currentWavesTop += (this.wavesTop - this.currentWavesTop) * 0.1;

      // Use cached dimensions — no layout reads inside the hot path
      const width = this.vw;
      const height = this.vh;

      this.ctx.clearRect(0, 0, width, height);

      // ==========================================
      // LAYER 1: GRID DITHER FIELD (Optimized)
      // ==========================================
      const gridRGB = this.isDarkMode ? CONFIG.grid.darkColor : CONFIG.grid.lightColor;
      const opacityMultiplier = this.isDarkMode
        ? CONFIG.grid.darkOpacityMultiplier
        : CONFIG.grid.lightOpacityMultiplier;
      const centerX = width / 2;
      const centerY = height / 2;
      const maxDist = Math.sqrt(centerX * centerX + centerY * centerY);
      const mouseInfluenceRadius = 200;

      for (let i = 0; i < this.gridDots.length; i++) {
        const dot = this.gridDots[i];
        const parallaxY = this.scrollY * CONFIG.grid.parallaxSpeed;
        let x = dot.baseX;
        let y = dot.baseY + parallaxY;

        // Wave fade: fade out elements disappearing behind footer waves
        let waveFade = 1;
        if (this.currentWavesTop < height + 150) {
          const fadeStart = this.currentWavesTop - 60;
          const fadeEnd = this.currentWavesTop + 30;
          if (y > fadeStart) {
            waveFade = Math.max(0, 1 - (y - fadeStart) / (fadeEnd - fadeStart));
          }
        }
        if (waveFade <= 0.005) continue;

        // Center fade / vignette (always calculate this - it's cheap)
        const distFromCenter = Math.sqrt((dot.baseX - centerX) ** 2 + (dot.baseY - centerY) ** 2);
        const centerFade = Math.pow(distFromCenter / maxDist, 1.2);
        let opacity = dot.baseOpacity * centerFade * opacityMultiplier * waveFade;

        // Mouse displacement - ONLY for dots near cursor (huge optimization!)
        const dx = this.mouse.x - x;
        const dy = this.mouse.y - y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < mouseInfluenceRadius) {
          const influence = 1 - dist / mouseInfluenceRadius;
          if (dist > 0) {
            x += (dx / dist) * influence * -8;
            y += (dy / dist) * influence * -8;
          }
          opacity += influence * 0.05; // Boost mouse interactive glow
        }

        if (opacity > 0.01) {
          this.ctx.fillStyle = `rgba(${gridRGB}, ${Math.min(opacity, 1)})`;
          this.ctx.fillRect(x, y, dot.size, dot.size);
        }
      }

      // ==========================================
      // LAYER 2: STARDUST with PARALLAX & TWINKLE (Dark Mode Only)
      // ==========================================
      if (this.isDarkMode && this.stars.length > 0) {
        const mouseCenterX = this.mouse.x - width / 2;
        const mouseCenterY = this.mouse.y - height / 2;

        for (let i = 0; i < this.stars.length; i++) {
          const star = this.stars[i];

          // 1. Scroll Parallax with infinite wrapping
          const scrollOffset = this.scrollY * star.speed;
          let y = (((star.baseY - scrollOffset) % height) + height) % height;

          // 2. Subtle 3D Mouse Parallax tilt based on star depth
          let x = star.baseX + mouseCenterX * star.speed * CONFIG.stars.mouseParallaxFactor;
          x = ((x % width) + width) % width;

          // 3. Wave Fade: Gracefully disappear behind footer waves
          let waveFade = 1;
          if (this.currentWavesTop < height + 150) {
            const fadeStart = this.currentWavesTop - 60;
            const fadeEnd = this.currentWavesTop + 30;
            if (y > fadeStart) {
              waveFade = Math.max(0, 1 - (y - fadeStart) / (fadeEnd - fadeStart));
            }
          }

          if (waveFade <= 0.005) continue; // Hidden behind footer waves

          // 4. Mouse proximity repulsion
          const dx = this.mouse.x - x;
          const dy = this.mouse.y - y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const influence = Math.max(0, 1 - dist / mouseInfluenceRadius);

          if (dist > 0 && influence > 0) {
            x += (dx / dist) * influence * -6;
            y += (dy / dist) * influence * -6;
          }

          // 5. Subtle organic twinkle
          const twinkle = Math.sin(this.time * star.twinkleSpeed + star.twinklePhase) * 0.12;
          const finalOpacity = Math.max(0, Math.min(1, (star.opacity + twinkle + influence * 0.08) * waveFade));

          this.ctx.globalAlpha = finalOpacity;
          this.ctx.fillStyle = `rgba(${CONFIG.stars.color}, 1)`;
          this.ctx.fillRect(x, y, star.size, star.size);
        }
        this.ctx.globalAlpha = 1;
      }

      // ==========================================
      // LAYER 3: SHOOTING STARS (Dark Mode Only)
      // ==========================================
      if (this.isDarkMode && CONFIG.shootingStars.enabled && !this.prefersReducedMotion) {
        // Random chance to spawn a new shooting star
        if (
          Math.random() < CONFIG.shootingStars.spawnProbability &&
          this.activeShootingStars.length < CONFIG.performance.maxShootingStars
        ) {
          this.spawnShootingStar();
        }

        // Render & update active shooting stars
        for (let i = this.activeShootingStars.length - 1; i >= 0; i--) {
          const ss = this.activeShootingStars[i];

          ss.x += ss.dx;
          ss.y += ss.dy;
          ss.opacity -= 0.012; // Fade out slowly

          // Wave Fade: Disappear if entering footer waves zone
          let ssWaveFade = 1;
          if (this.currentWavesTop < height + 150) {
            const fadeStart = this.currentWavesTop - 40;
            const fadeEnd = this.currentWavesTop + 30;
            if (ss.y > fadeStart) {
              ssWaveFade = Math.max(0, 1 - (ss.y - fadeStart) / (fadeEnd - fadeStart));
            }
          }

          const effectiveOpacity = Math.max(0, ss.opacity * ssWaveFade);

          // Remove when offscreen or faded out
          if (effectiveOpacity <= 0.01 || ss.x > width + 100 || ss.y > height + 100) {
            this.activeShootingStars.splice(i, 1);
            continue;
          }

          // Draw line trail
          const tailX = ss.x - Math.cos(ss.angle) * ss.length;
          const tailY = ss.y - Math.sin(ss.angle) * ss.length;

          const gradient = this.ctx.createLinearGradient(ss.x, ss.y, tailX, tailY);
          gradient.addColorStop(0, `rgba(${CONFIG.shootingStars.color}, ${effectiveOpacity})`);
          gradient.addColorStop(1, `rgba(${CONFIG.shootingStars.color}, 0)`);

          this.ctx.beginPath();
          this.ctx.moveTo(ss.x, ss.y);
          this.ctx.lineTo(tailX, tailY);
          this.ctx.strokeStyle = gradient;
          this.ctx.lineWidth = 1.2;
          this.ctx.stroke();
        }
      }

      this.animationFrameId = requestAnimationFrame(this.animate);
    };

    public destroy() {
      if (this.animationFrameId) cancelAnimationFrame(this.animationFrameId);
      if (this.observer) this.observer.disconnect();
      window.removeEventListener("resize", this.resize);
    }
  }

  let bgInstance: UnifiedBackground | null = null;

  function initBg() {
    if (bgInstance) bgInstance.destroy();
    const canvas = document.getElementById("astro-bg-canvas");
    if (canvas) {
      bgInstance = new UnifiedBackground("astro-bg-canvas");
    }
  }

  document.addEventListener("astro:page-load", initBg);

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initBg();
  } else {
    document.addEventListener("DOMContentLoaded", initBg);
  }
</script>
