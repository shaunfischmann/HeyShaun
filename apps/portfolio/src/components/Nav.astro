---
import { Sun, Moon, Menu, X } from "@lucide/astro";
import type { Lang } from "../i18n/utils";
import { getTranslations } from "../i18n/utils";

export interface Props {
  lang?: Lang;
  isHomepage?: boolean;
  currentPath?: string;
}

const { lang = "en", isHomepage = true, currentPath = "" } = Astro.props;
const t = getTranslations(lang);

// Define navigation links: use direct `#id` on the home page for native smooth scrolling
const navLinks = [
  { href: isHomepage ? "#about" : `/${lang}/#about`, label: t.nav.about, id: "about", i18n: "nav.about", num: "01" },
  {
    href: isHomepage ? "#timeline" : `/${lang}/#timeline`,
    label: t.nav.timeline,
    id: "timeline",
    i18n: "nav.timeline",
    num: "02",
  },
  { href: isHomepage ? "#art" : `/${lang}/#art`, label: t.nav.art, id: "art", i18n: "nav.art", num: "03" },
  {
    href: isHomepage ? "#contact" : `/${lang}/#contact`,
    label: t.nav.contact,
    id: "contact",
    i18n: "nav.contact",
    num: "04",
  },
];

const enTarget = `/en${currentPath === "/" ? "/" : currentPath}`;
const frTarget = `/fr${currentPath === "/" ? "/" : currentPath}`;
---

<nav id="site-nav" class={isHomepage ? "is-homepage" : ""} role="navigation" aria-label="Main Navigation">
  <!-- Fixed Top-Left Logo -->
  <a
    href={isHomepage ? "#hero" : `/${lang}/`}
    class="corner-logo"
    id="brand-logo-link"
    aria-label="Shaun Fischmann — Home"
  >
    <span class="brand-logo-wrap">
      <img src="/sf-logo.svg" alt="Shaun Fischmann logo" class="brand-logo brand-logo--normal" width="88" height="58" />
      <img
        src="/sf-logo-glitch.svg"
        alt=""
        class="brand-logo brand-logo--glitch"
        width="88"
        height="58"
        aria-hidden="true"
      />
    </span>
  </a>

  <!-- Desktop Top Right Controls (Language Switcher + Light/Dark Theme Toggle) -->
  <div class="top-controls-bar">
    <!-- Language Toggle Pill -->
    <div class="lang-pill" role="group" aria-label="Language selector">
      <a
        href={enTarget}
        class={`lang-pill__btn ${lang === "en" ? "active" : ""}`}
        data-lang="en"
        aria-label="Switch to English"
      >
        EN
      </a>
      <a
        href={frTarget}
        class={`lang-pill__btn ${lang === "fr" ? "active" : ""}`}
        data-lang="fr"
        aria-label="Passer en français"
      >
        FR
      </a>
    </div>

    <!-- Theme Toggle Button -->
    <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme" title="Toggle dark/light mode">
      <Sun class="sun-icon" size="20" color="currentColor" stroke-width="2" />
      <Moon class="moon-icon" size="20" color="currentColor" stroke-width="2" />
    </button>
  </div>

  <!-- Minimalist Left Side Navigation -->
  {
    isHomepage && (
      <aside class="side-menu" aria-label="Section navigation">
        <ul class="nav-list" role="list">
          {navLinks.map((link, index) => {
            return (
              <li>
                <a href={link.href} class={`nav-item ${index === 0 ? "active" : ""}`} data-section={link.id}>
                  <span class="nav-num" aria-hidden="true">
                    {link.num}
                  </span>
                  <span class="nav-label" data-i18n={link.i18n}>
                    {link.label}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    )
  }

  <!-- Mobile / Tablet Top Bar (Active under 1180px screen width) -->
  <div class="mobile-bar">
    <a href={isHomepage ? "#hero" : `/${lang}/#hero`} class="mobile-brand-title" aria-label="Shaun Fischmann — Home">
      <img src="/sf-logo.svg" alt="SF" class="mobile-logo" width="60" height="40" />
    </a>
    <div class="mobile-right">
      <!-- Mobile Language Toggle -->
      <div class="lang-pill" role="group" aria-label="Language selector">
        <a href={enTarget} class={`lang-pill__btn ${lang === "en" ? "active" : ""}`} data-lang="en" aria-label="EN">
          EN
        </a>
        <a href={frTarget} class={`lang-pill__btn ${lang === "fr" ? "active" : ""}`} data-lang="fr" aria-label="FR">
          FR
        </a>
      </div>

      <button id="mobile-theme-toggle" class="theme-btn" aria-label="Toggle theme">
        <Sun class="sun-icon" size="20" color="currentColor" stroke-width="2" />
        <Moon class="moon-icon" size="20" color="currentColor" stroke-width="2" />
      </button>

      <button id="nav-toggle" class="mobile-toggle-btn" aria-expanded="false" aria-label="Toggle navigation">
        <Menu class="icon-open" size="20" color="currentColor" stroke-width="2" />
        <X class="icon-close" size="20" color="currentColor" stroke-width="2" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul class="nav-list mobile-nav-list" role="list">
      {
        navLinks.map((link, index) => {
          return (
            <li>
              <a href={link.href} class={`nav-item mobile-item ${index === 0 ? "active" : ""}`} data-section={link.id}>
                <span class="nav-num" aria-hidden="true">
                  {link.num}
                </span>
                <span class="nav-label" data-i18n={link.i18n}>
                  {link.label}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  /* ── Top-Right Controls Bar (Lang Pill + Theme Toggle) ── */
  .top-controls-bar {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--neu-shadow-outset);
  }

  /* ── Language Toggle Pill ───────────────────────────────────── */
  .lang-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--glass-bg);
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .lang-pill__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-muted);
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .lang-pill__btn.active {
    background: var(--color-primary);
    color: #fff;
    box-shadow:
      0 2px 8px var(--glow-primary),
      inset 0 0 0 1px var(--color-border);
    transform: scale(1.05);
  }

  .lang-pill__btn:hover:not(.active) {
    color: var(--color-text);
    background: var(--color-surface-hover);
    box-shadow:
      0 0 8px var(--glow-primary),
      inset 0 0 0 1px var(--color-primary);
  }

  /* ── Theme Toggle ─────────────────────────────────────────── */
  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 32px;
    border: none;
    background: var(--glass-bg);
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .theme-btn:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
    box-shadow:
      0 0 8px var(--glow-primary),
      inset 0 0 0 1px var(--color-primary);
  }

  /* Theme Icons (unchanged) */
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }
  :global([data-theme="light"]) .sun-icon {
    display: none;
  }
  :global([data-theme="light"]) .moon-icon {
    display: block;
  }

  /* ── Fixed Top-Left Logo ── */
  .corner-logo {
    position: fixed;
    top: 1.25rem;
    left: clamp(1rem, 2.5vw, 2.25rem);
    z-index: 101;
    text-decoration: none;
    display: block;
  }

  /* ── Brand Logo (corner + glitch) ── */
  .brand-logo-wrap {
    position: relative;
    display: block;
    width: clamp(70px, 6vw, 88px);
    height: clamp(46px, 4vw, 58px);
  }

  .brand-logo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.05s step-start;
  }

  .brand-logo--normal {
    opacity: 1;
  }

  .brand-logo--glitch {
    opacity: 0;
    pointer-events: none;
  }

  /* Hover: swap to glitch */
  .corner-logo:hover .brand-logo--normal,
  .brand-logo-wrap.is-glitching .brand-logo--normal {
    opacity: 0;
  }

  .corner-logo:hover .brand-logo--glitch,
  .brand-logo-wrap.is-glitching .brand-logo--glitch {
    opacity: 1;
  }

  /* ── Minimalist Left Side Navigation Bar ── */
  .side-menu {
    position: fixed;
    top: 12%;
    left: clamp(1rem, 2vw, 2rem);
    transform: translateY(-12%);
    z-index: 99;
    display: flex;
    flex-direction: column;
    padding: 0;
    background: transparent;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem;
    font-family: var(--font-heading);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme="dark"]) .nav-item {
    text-shadow:
      0 1px 4px rgba(0, 0, 0, 0.55),
      0 0 8px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme="light"]) .nav-item {
    text-shadow:
      0 1px 3px rgba(255, 255, 255, 0.8),
      0 0 6px rgba(255, 255, 255, 0.6);
  }

  /* Number styling (1., 2., 3., 4.) */
  .nav-num {
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--color-text-faint);
    transition:
      color var(--transition-fast),
      font-weight var(--transition-fast);
    flex-shrink: 0;
  }

  /* Label styling */
  .nav-label {
    font-size: clamp(0.95rem, 1vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    transition:
      color var(--transition-fast),
      font-weight var(--transition-fast);
  }

  /* Hover State */
  .nav-item:hover {
    transform: translateX(3px);
  }

  .nav-item:hover .nav-num {
    color: var(--color-secondary);
  }

  .nav-item:hover .nav-label {
    color: var(--color-text);
  }

  /* Active State */
  .nav-item.active {
    transform: translateX(4px);
  }

  .nav-item.active .nav-num {
    color: var(--color-secondary);
  }

  .nav-item.active .nav-label {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Mobile / Tablet Bar */
  .mobile-bar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
    justify-content: space-between;
  }

  .mobile-brand-title {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .mobile-logo {
    display: block;
    object-fit: contain;
  }

  .mobile-right {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .mobile-toggle-btn {
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .icon-close {
    display: none;
  }

  .mobile-menu {
    position: fixed;
    top: 3.25rem;
    left: 0;
    right: 0;
    z-index: 99;
    padding: 1.5rem 1rem;
    background: var(--glass-bg-strong);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mobile-item {
    gap: 1rem;
    font-size: 1rem;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-heading);
  }

  /* ── Nav Visibility ────────────────────────────
     Default: show mobile bar; hide desktop nav elements.
     At --lg (1024px+): reveal desktop nav, hide mobile bar.   */
  .side-menu {
    display: none;
  }
  .top-controls-bar {
    display: none;
  }
  .corner-logo {
    display: none;
  }
  .mobile-bar {
    display: flex;
  }

  @media (--lg) {
    .side-menu {
      display: flex;
    }
    .top-controls-bar {
      display: flex;
    }
    .corner-logo {
      display: block;
    }
    .mobile-bar {
      display: none;
    }
  }

  /* ── Hero Scroll Visibility for Homepage ─────────────────────────
     Logo, side menu, and mobile bar are hidden while inside the Hero
     section and smoothly glide in when scrolled past it.           */
  .is-homepage .corner-logo {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-14px);
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-homepage .side-menu {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-20px);
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-homepage .mobile-bar {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
    transition:
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Scrolled Past Hero State ── */
  .is-homepage.scrolled-past-hero .corner-logo {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .is-homepage.scrolled-past-hero .side-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .is-homepage.scrolled-past-hero .mobile-bar,
  .is-homepage.is-menu-open .mobile-bar,
  .is-homepage:has(#mobile-menu:not([hidden])) .mobile-bar {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  // ── Hero Scroll Detection for Logo & Menu Visibility ────────
  (function () {
    const siteNav = document.getElementById("site-nav");
    if (!siteNav || !siteNav.classList.contains("is-homepage")) return;

    const hero = document.getElementById("hero");
    if (!hero) {
      siteNav.classList.add("scrolled-past-hero");
      return;
    }

    const checkHeroVisibility = () => {
      const rect = hero.getBoundingClientRect();
      // When hero bottom passes 40% of viewport height (scrolled out of hero)
      const isPastHero = rect.bottom <= window.innerHeight * 0.4;
      siteNav.classList.toggle("scrolled-past-hero", isPastHero);
    };

    window.addEventListener("scroll", checkHeroVisibility, { passive: true });
    checkHeroVisibility();
  })();
  // ── Random logo glitch ────────────────────────────────────────
  (function () {
    const wrap = document.querySelector<HTMLElement>(".brand-logo-wrap");
    if (!wrap) return;

    function scheduleGlitch() {
      // Fire every 8–20 seconds
      const delay = 8000 + Math.random() * 12000;
      setTimeout(() => {
        // Glitch for 120–420ms
        const duration = 120 + Math.random() * 300;
        wrap.classList.add("is-glitching");
        setTimeout(() => {
          wrap.classList.remove("is-glitching");
          scheduleGlitch();
        }, duration);
      }, delay);
    }

    scheduleGlitch();
  })();

  // ── Theme Toggle ─────────────────────────────────────────────
  function getPreferredTheme() {
    const saved = localStorage.getItem("theme");
    if (saved) return saved;
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }

  function setTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
  }

  setTheme(getPreferredTheme());

  document.querySelectorAll("#theme-toggle, #mobile-theme-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme");
      setTheme(current === "light" ? "dark" : "light");
    });
  });

  // ── Active section tracking & Anchor hash preservation ────────
  const navItems = document.querySelectorAll<HTMLElement>(".nav-item");
  const sideMenu = document.querySelector<HTMLElement>(".side-menu");
  const sections = document.querySelectorAll<HTMLElement>("section[id], footer[id]");
  let activeSectionId = "";

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          activeSectionId = entry.target.getAttribute("id") || "";
          navItems.forEach((item) => {
            item.classList.toggle("active", item.getAttribute("data-section") === activeSectionId);
          });
        }
      });
    },
    { rootMargin: "-20% 0px -50% 0px" },
  );

  sections.forEach((sec) => sectionObserver.observe(sec));

  // Language switcher: preserve current section anchor hash on navigation
  document.querySelectorAll<HTMLAnchorElement>(".lang-pill__btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const hash = window.location.hash || (activeSectionId && activeSectionId !== "hero" ? `#${activeSectionId}` : "");
      if (hash) {
        const rawHref = btn.getAttribute("href") || "";
        const cleanPath = rawHref.split("#")[0].replace(/\/$/, "");
        btn.href = `${cleanPath}/${hash}`;
      }
    });
  });

  // ── Mobile menu toggle ───────────────────────────────────────
  const toggle = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const siteNavEl = document.getElementById("site-nav");
  const iconOpen = toggle?.querySelector(".icon-open") as HTMLElement | null;
  const iconClose = toggle?.querySelector(".icon-close") as HTMLElement | null;

  toggle?.addEventListener("click", () => {
    const isCurrentlyOpen = toggle.getAttribute("aria-expanded") === "true";
    const nextState = !isCurrentlyOpen;
    toggle.setAttribute("aria-expanded", String(nextState));
    mobileMenu?.toggleAttribute("hidden");
    siteNavEl?.classList.toggle("is-menu-open", nextState);
    if (iconOpen && iconClose) {
      iconOpen.style.display = nextState ? "none" : "block";
      iconClose.style.display = nextState ? "block" : "none";
    }
  });

  document.querySelectorAll(".mobile-item").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      mobileMenu?.setAttribute("hidden", "");
      siteNavEl?.classList.remove("is-menu-open");
      if (iconOpen && iconClose) {
        iconOpen.style.display = "block";
        iconClose.style.display = "none";
      }
    });
  });

  // ── Multilingual i18n System ─────────────────────────────────
  const TRANSLATIONS: Record<string, Record<string, string>> = {};

  async function loadTranslations(lang: string) {
    if (TRANSLATIONS[lang]) return TRANSLATIONS[lang];
    try {
      const res = await fetch(`/i18n/${lang}.json`);
      if (!res.ok) return {};
      const data = await res.json();
      TRANSLATIONS[lang] = flattenObject(data);
      return TRANSLATIONS[lang];
    } catch {
      return {};
    }
  }

  function flattenObject(obj: Record<string, unknown>, prefix = ""): Record<string, string> {
    return Object.entries(obj).reduce(
      (acc, [key, val]) => {
        const path = prefix ? `${prefix}.${key}` : key;
        if (typeof val === "object" && val !== null) {
          Object.assign(acc, flattenObject(val as Record<string, unknown>, path));
        } else {
          acc[path] = String(val);
        }
        return acc;
      },
      {} as Record<string, string>,
    );
  }

  async function applyLanguage(lang: string, animate = false) {
    const t = await loadTranslations(lang);
    if (!Object.keys(t).length) return;

    const elements = document.querySelectorAll<HTMLElement>("[data-i18n], [data-i18n-placeholder], [data-i18n-label]");

    if (animate) {
      // Step 1: Fade / blur out current text
      elements.forEach((el) => el.classList.add("i18n-swap-out"));
      await new Promise((resolve) => setTimeout(resolve, 140));
    }

    // Step 2: Swap content
    elements.forEach((el) => {
      if (el.hasAttribute("data-i18n")) {
        const key = el.getAttribute("data-i18n") || "";
        if (t[key] !== undefined) el.innerHTML = t[key];
      }
      if (el.hasAttribute("data-i18n-placeholder")) {
        const key = el.getAttribute("data-i18n-placeholder") || "";
        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
          if (t[key] !== undefined) el.placeholder = t[key];
        }
      }
      if (el.hasAttribute("data-i18n-label")) {
        const key = el.getAttribute("data-i18n-label") || "";
        if (t[key] !== undefined) el.setAttribute("aria-label", t[key]);
      }
    });

    if (animate) {
      // Step 3: Unblur & spring back in
      requestAnimationFrame(() => {
        elements.forEach((el) => el.classList.remove("i18n-swap-out"));
      });
    }

    // Update html lang attribute
    document.documentElement.lang = lang;
    localStorage.setItem("lang", lang);

    // Update toggle button states
    document.querySelectorAll<HTMLElement>("[data-lang]").forEach((btn) => {
      btn.classList.toggle("active", btn.getAttribute("data-lang") === lang);
    });
  }
</script>
