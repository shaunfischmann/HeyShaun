<script>
  const stage = document.getElementById("constellation-stage");
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));

  let activeCategory: string | null = null;
  let activeFocusedNode: HTMLElement | null = null;

  // Angles for 3D sphere rotation
  let angleX = 0;
  let angleY = 0;

  const baseSpeedX = 0.0008;
  const baseSpeedY = 0.0018;

  let currentSpeedX = baseSpeedX;
  let currentSpeedY = baseSpeedY;

  let isHovered = false;
  const hoverSpeedFactor = 0.5;

  let lastTime = performance.now();

  const brightnessFloor = 0.4;

  // PERFORMANCE: Cache DOM queries
  let allNodes: HTMLElement[] = [];
  let visibleNodesCache: HTMLElement[] = [];
  let needsLayoutRecalc = false;

  function updateVisibleNodesCache() {
    visibleNodesCache = Array.from(document.querySelectorAll<HTMLElement>(".constellation-node:not(.hidden)"));
  }

  // Lazy layout recalculation - only when needed
  function layout3DSphere() {
    updateVisibleNodesCache();
    const total = visibleNodesCache.length;
    if (total === 0) return;

    const stageWidth = stage?.clientWidth || 360;
    const isMobile = window.innerWidth < 640;

    const radiusX = isMobile ? Math.min((stageWidth - 100) * 0.45, 120) : Math.min(stageWidth * 0.4, 220);
    const radiusY = isMobile ? 110 : 160;
    const radiusZ = isMobile ? 120 : 180;

    const phi = Math.PI * (3 - Math.sqrt(5));

    for (let i = 0; i < total; i++) {
      const node = visibleNodesCache[i];
      const y = 1 - (i / (total - 1 || 1)) * 2;
      const radiusAtY = Math.sqrt(1 - y * y);
      const theta = phi * i;

      const x = Math.cos(theta) * radiusAtY;
      const z = Math.sin(theta) * radiusAtY;

      node.dataset.x = String(x * radiusX);
      node.dataset.y = String(y * radiusY);
      node.dataset.z = String(z * radiusZ);
    }
  }

  window.addEventListener(
    "resize",
    () => {
      layout3DSphere();
    },
    { passive: true },
  );

  function lerp(start: number, end: number, factor: number): number {
    return start + (end - start) * factor;
  }

  // PERFORMANCE: Optimized animation loop
  // Only update every other frame on low-end devices if needed
  function animate(now = performance.now()) {
    const delta = Math.min((now - lastTime) / 16.67, 2.5);
    lastTime = now;

    const isDark = document.documentElement.getAttribute("data-theme") !== "light";

    const targetFactor = isHovered ? hoverSpeedFactor : 1.0;
    const lerpRate = 0.05;

    currentSpeedX = lerp(currentSpeedX, baseSpeedX * targetFactor, lerpRate);
    currentSpeedY = lerp(currentSpeedY, baseSpeedY * targetFactor, lerpRate);

    angleX += currentSpeedX * delta;
    angleY += currentSpeedY * delta;

    const cosX = Math.cos(angleX);
    const sinX = Math.sin(angleX);
    const cosY = Math.cos(angleY);
    const sinY = Math.sin(angleY);

    // Use cached visible nodes
    updateVisibleNodesCache();

    for (let i = 0; i < visibleNodesCache.length; i++) {
      const node = visibleNodesCache[i];

      // ── FOCUSED MODE ────────────────────────────────────────────────
      if (activeFocusedNode && node === activeFocusedNode) {
        node.style.transform = `translate3d(0px, 0px, 0px) scale(1.35)`;
        node.style.opacity = "1";
        node.style.filter = "none";
        node.style.zIndex = "1000";
        continue;
      }

      // ── NORMAL MODE ─────────────────────────────────────────────────
      const baseX = parseFloat(node.dataset.x || "0");
      const baseY = parseFloat(node.dataset.y || "0");
      const baseZ = parseFloat(node.dataset.z || "0");

      // Rotate point around Y axis
      const x1 = baseX * cosY + baseZ * sinY;
      const z1 = -baseX * sinY + baseZ * cosY;

      // Rotate point around X axis
      const y2 = baseY * cosX - z1 * sinX;
      const z2 = baseY * sinX + z1 * cosX;

      // Normalize Z value to a 0.0 (back) -> 1.0 (front) range
      const normalizedDepth = Math.max(0, Math.min(1, (z2 + 180) / 360));

      // Perspective Scale projection
      const cameraDistance = 600;
      const scale = cameraDistance / (cameraDistance - z2);
      const screenX = x1 * scale;
      const screenY = y2 * scale;

      // Dynamic z-index prevents back nodes from overlapping front ones
      const zIndexValue = Math.round(normalizedDepth * 100);
      node.style.zIndex = String(zIndexValue);

      // Translation & Scale
      node.style.transform = `translate3d(${screenX.toFixed(2)}px, ${screenY.toFixed(2)}px, 0px) scale(${scale.toFixed(3)})`;

      if (activeFocusedNode) {
        // ── OTHER NODES WHEN ONE IS SELECTED ──────────────────────────
        node.style.opacity = isDark ? "0.25" : "0.65";
        node.style.filter = isDark ? "blur(2px) brightness(0.5)" : "blur(2px) brightness(1.2)";
      } else {
        // ── NORMAL FLOATING MODE ──
        const minOpacity = isDark ? 0.15 : 0.35;
        const opacityRange = isDark ? 0.85 : 0.65;
        node.style.opacity = String((minOpacity + normalizedDepth * opacityRange).toFixed(2));

        if (isDark) {
          const brightness = brightnessFloor + (1 - brightnessFloor) * normalizedDepth * normalizedDepth;
          node.style.filter = `brightness(${brightness.toFixed(3)})`;
        } else {
          const lightness = 1.0 + (1 - normalizedDepth) * 0.25;
          node.style.filter = `brightness(${lightness.toFixed(3)})`;
        }
      }
    }

    requestAnimationFrame(animate);
  }

  if (stage) {
    stage.addEventListener("mouseenter", () => {
      isHovered = true;
    });
    stage.addEventListener("mouseleave", () => {
      isHovered = false;
    });
  }

  function clearFocus() {
    if (activeFocusedNode) {
      activeFocusedNode.classList.remove("focused");
      activeFocusedNode = null;
    }
  }

  allNodes = Array.from(document.querySelectorAll<HTMLElement>(".constellation-node"));

  allNodes.forEach((node) => {
    node.addEventListener("click", (e) => {
      e.stopPropagation();
      if (activeFocusedNode === node) {
        clearFocus();
      } else {
        clearFocus();
        activeFocusedNode = node;
        node.classList.add("focused");
      }
    });
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selectedCategory = btn.getAttribute("data-category");

      if (activeCategory === selectedCategory) {
        activeCategory = null;
        btn.classList.remove("active");
      } else {
        activeCategory = selectedCategory;
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
      }

      clearFocus();

      updateVisibleNodesCache();
      visibleNodesCache.forEach((n) => n.classList.add("animating-out"));

      setTimeout(() => {
        allNodes.forEach((node) => {
          node.classList.remove("animating-out");
          const nodeCat = node.getAttribute("data-category");
          const isHighlight = node.getAttribute("data-highlight") === "true";

          if (activeCategory === null) {
            node.classList.toggle("hidden", !isHighlight);
          } else {
            node.classList.toggle("hidden", nodeCat !== activeCategory);
          }
        });

        layout3DSphere();
      }, 300);
    });
  });

  // Initial setup: no filter active by default
  allNodes.forEach((node) => {
    const isHighlight = node.getAttribute("data-highlight") === "true";
    node.classList.toggle("hidden", !isHighlight);
  });

  // Unfocus when clicking anywhere else on the page
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".constellation-node") && !target.closest(".filter-btn")) {
      clearFocus();
    }
  });

  layout3DSphere();
  animate();
</script>
