import type { Lang, Translations } from "../../i18n/utils";
import { getTranslations } from "../../i18n/utils";

export interface Props {
  lang?: Lang;
  t?: Translations;
}

const { lang = "en" } = Astro.props;
const t = Astro.props.t || getTranslations(lang);

const categoryLabels: Record<Category, string> = {
  Tech: t.about.filter_tech || "Tech",
  Creative: t.about.filter_creative || "Creative",
  Hobby: t.about.filter_hobby || "Hobby",
};

const getSkillText = (key: string, fallback: string) => {
  if (!key) return fallback;
  const val = (t.about as Record<string, string>)[key];
  return val !== undefined ? val : fallback;
};

// Import all SVGs as raw strings at build time to avoid browser mask refetch loops in animation
const svgRawFiles = import.meta.glob<string>("../../../public/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

function getSvgContent(iconPath?: string): string {
  if (!iconPath) return "";
  const fileName = iconPath.split("/").pop();
  return svgRawFiles[`../../../public/icons/${fileName}`] || "";
}
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container">
    <p class="section-tag" data-reveal data-i18n="about.tag">{t.about.tag}</p>
    <h2 id="about-heading" class="section-title" data-reveal data-delay="1">
      <span class="gradient-text" data-i18n="about.heading">{t.about.heading}</span>
    </h2>
    <p class="section-sub" data-reveal data-delay="1" data-i18n="about.sub">{t.about.sub}</p>

    <div class="about-layout">
      <!-- Bio Card -->
      <aside class="bio-card glass-card" data-reveal="slide-left" data-delay="2" aria-label="About Shaun">
        <h3 class="bio-heading" data-i18n="about.bio_heading">{t.about.bio_heading}</h3>
        <a href="https://www.apimo.net" target="_blank" rel="noopener noreferrer" class="apimo-link">
          <img src="/apimo-logo.svg" alt="Apimo" class="apimo-logo apimo-logo--color" width="60" height="20" />
          <img
            src="/apimo-logo-white.svg"
            alt=""
            aria-hidden="true"
            class="apimo-logo apimo-logo--white"
            width="60"
            height="20"
          />
        </a>
        <p class="bio-text" data-i18n="about.bio_text" set:html={t.about.bio_text} />
      </aside>

      <!-- 3D Constellation Cloud -->
      <div class="constellation-wrapper" data-reveal data-delay="2">
        <!-- Toggle Filter Bar -->
        <div class="constellation-filters filter-group" role="group" aria-label="Filter skill constellation">
          {
            categories.map((cat) => (
              <button class="filter-btn" data-category={cat}>
                {categoryLabels[cat]}
              </button>
            ))
          }
        </div>

        <!-- Transparent 3D Stage -->
        <div class="constellation-stage" id="constellation-stage">
          <!-- Organic Cosmic Nebula Cloud -->
          <div class="constellation-nebula" aria-hidden="true">
            <div class="gas-layer gas-1"></div>
            <div class="gas-layer gas-2"></div>
            <div class="gas-layer gas-core"></div>
          </div>

          <div class="sphere-cloud" id="sphere-cloud">
            {
              skills.map((skill) => {
                const LucideIcon = skill.lucideIcon;
                const skillName = getSkillText(skill.nameKey, skill.name);
                const skillDesc = getSkillText(skill.descKey, skill.desc);
                const svgContent = getSvgContent(skill.svgIcon);
                return (
                  <div
                    class={`constellation-node cat-${skill.category.toLowerCase()}`}
                    data-id={skill.id}
                    data-category={skill.category}
                    data-highlight={skill.highlight ? "true" : "false"}
                  >
                    <div class="node-bubble" aria-label={skillName}>
                      {svgContent ? (
                        <span
                          class="skill-icon"
                          data-color={skill.color}
                          role="img"
                          aria-label={skillName}
                          set:html={svgContent}
                        />
                      ) : LucideIcon ? (
                        <LucideIcon class="skill-lucide-icon" size={24} />
                      ) : null}
                    </div>

                    <div class="node-tooltip">
                      <span class="tooltip-title" data-i18n={skill.nameKey}>
                        {skillName}
                      </span>
                      <span class="tooltip-desc" data-i18n={skill.descKey}>
                        {skillDesc}
                      </span>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    overflow-x: clip;
  }

  /* ── About me / Bio ── */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 2rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    align-items: start;

    @media (--md) {
      grid-template-columns: 0.75fr 1fr;
      gap: clamp(1.5rem, 2rem, 2.5rem);
    }
  }

  .bio-card {
    padding: clamp(1.5rem, 3vw, 2rem) clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: static;
    z-index: 1;

    @media (--md) {
      position: sticky;
      top: 2rem;
    }
  }

  .bio-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .apimo-link {
    display: inline-flex;
    align-items: center;
  }

  .apimo-logo {
    display: block;
    object-fit: contain;
    height: clamp(32px, 5vw, 40px);
    width: auto;
    vertical-align: middle;
  }

  /* Dark / light logo switching */
  .apimo-logo--color {
    display: block;
  }
  .apimo-logo--white {
    display: none;
  }
  :global([data-theme="dark"]) .apimo-logo--color {
    display: none;
  }
  :global([data-theme="dark"]) .apimo-logo--white {
    display: block;
  }

  .bio-text {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1.2vw, 0.9rem);
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  /* ── Filters & Stage ── */
  .constellation-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 100%;
  }

  .constellation-filters {
    place-content: center;
    z-index: 5;
  }

  /* ── Fully Transparent 3D Stage ── */
  .constellation-stage {
    position: relative;
    width: 100%;
    height: 380px;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    /* Ensures children with z-index are stacked relative to the stage */
    isolation: isolate;

    @media (--md) {
      height: 500px;
    }
  }

  /* ── Cosmic Nebula Wrapper ── */
  .constellation-nebula {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(340px, 55vw, 680px);
    height: clamp(260px, 42vw, 500px);
    pointer-events: none;
    z-index: -1;
    filter: blur(35px);
    opacity: 0.65;
  }

  :root[data-theme="dark"] .constellation-nebula {
    opacity: 0.5; /* Slightly softer in dark mode to keep canvas stars visible */
  }

  /* ── Shared Gas Layer Base ── */
  .gas-layer {
    position: absolute;
    inset: 0;
    border-radius: 40% 60% 70% 30% / 50% 30% 70% 50%;
    mix-blend-mode: screen;
  }

  :root[data-theme="light"] .gas-layer {
    mix-blend-mode: multiply;
  }

  /* ── Primary Gas Swirl (Violet/Primary Tint) ── */
  .gas-1 {
    background: radial-gradient(
      ellipse at 40% 40%,
      var(--color-primary, #6366f1) 0%,
      rgba(99, 102, 241, 0.4) 40%,
      transparent 75%
    );
    animation: nebulaDrift1 22s ease-in-out infinite alternate;
  }

  /* ── Secondary Gas Swirl (Cyan/Teal/Secondary Tint) ── */
  .gas-2 {
    inset: -10%;
    border-radius: 60% 40% 30% 70% / 40% 60% 40% 60%;
    background: radial-gradient(
      ellipse at 65% 60%,
      var(--color-secondary, #06b6d4) 0%,
      rgba(14, 165, 233, 0.3) 45%,
      transparent 80%
    );
    animation: nebulaDrift2 28s ease-in-out infinite alternate;
  }

  /* ── Dense Gas Core (Warm Glow Center) ── */
  .gas-core {
    inset: 15%;
    border-radius: 50%;
    filter: blur(22px);
    background: radial-gradient(
      circle at 50% 50%,
      rgba(244, 114, 182, 0.45) 0%,
      rgba(168, 85, 247, 0.25) 50%,
      transparent 80%
    );
    animation: corePulse 12s ease-in-out infinite alternate;
  }

  /* ── Slow Cosmic Morphing Animations ── */
  @keyframes nebulaDrift1 {
    0% {
      transform: rotate(0deg) scale(0.95) translate(0, 0);
      border-radius: 40% 60% 70% 30% / 50% 30% 70% 50%;
    }
    50% {
      transform: rotate(180deg) scale(1.08) translate(15px, -10px);
      border-radius: 60% 40% 40% 60% / 30% 60% 40% 70%;
    }
    100% {
      transform: rotate(360deg) scale(0.98) translate(-10px, 12px);
      border-radius: 40% 60% 70% 30% / 50% 30% 70% 50%;
    }
  }

  @keyframes nebulaDrift2 {
    0% {
      transform: rotate(360deg) scale(1.05) translate(0, 0);
    }
    50% {
      transform: rotate(180deg) scale(0.92) translate(-20px, 15px);
    }
    100% {
      transform: rotate(0deg) scale(1.05) translate(10px, -15px);
    }
  }

  @keyframes corePulse {
    0% {
      opacity: 0.4;
      transform: scale(0.88);
    }
    100% {
      opacity: 0.7;
      transform: scale(1.12);
    }
  }

  /* ── Performance guards for nebula ── */

  /* Mobile: disable the 3 concurrent keyframe animations + mix-blend-mode. */
  @media (--mobile-only) {
    .constellation-nebula {
      display: none;
    }
  }

  /* Stop all nebula animation for users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gas-1,
    .gas-2,
    .gas-core {
      animation: none !important;
    }
  }

  .sphere-cloud {
    position: relative;
    width: 0;
    height: 0;
    z-index: 1;
  }

  /* ── Nodes in 3D Space ── */
  .constellation-node {
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .constellation-node.hidden {
    display: none !important;
    opacity: 0;
  }

  /* ── Transition state when switching filters ── */
  .constellation-node.animating-out {
    animation: disappearIn 600ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes disappearIn {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(0.2);
    }
  }

  /* ── Node Icon Bubble ── */
  .node-bubble {
    width: 3.5rem;
    height: 3.5rem;
    margin-left: -1.75rem;
    margin-top: -1.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    cursor: pointer;
    position: relative;
    box-shadow: var(--neu-shadow-outset);
    background: var(--color-surface);

    /* Only animate on hover, not every frame */
    transition:
      transform var(--transition-spring),
      box-shadow var(--transition-fast);
  }

  /* Gradient Ring Container via Pseudo-Element */
  .node-bubble::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1px;
    border: 1px solid transparent;

    background-image:
      linear-gradient(var(--color-surface), var(--color-surface)),
      conic-gradient(from 0deg, var(--color-border), var(--color-border-hover), var(--color-border));
    background-origin: border-box;
    background-clip: padding-box, border-box;

    pointer-events: none;
    z-index: 0;

    transition: opacity var(--transition-fast);
  }

  /* Ensure child icon stays above the pseudo-element ring */
  .node-bubble > * {
    position: relative;
    z-index: 1;
  }

  .node-bubble:hover {
    transform: scale(1.22);
  }

  .constellation-node.focused .node-bubble {
    transform: scale(1.35);
    background: var(--color-surface-hover);
  }

  /* ── Gradient Hover State ── */
  .constellation-node:hover .node-bubble::before,
  .constellation-node.focused .node-bubble::before {
    background-image:
      linear-gradient(var(--color-surface-hover), var(--color-surface-hover)),
      conic-gradient(
        from 0deg,
        var(--color-primary),
        var(--color-secondary),
        #e17055,
        var(--pastel-lavender),
        var(--color-primary)
      );
  }

  .constellation-node:hover .node-bubble,
  .constellation-node.focused .node-bubble {
    box-shadow:
      0 0 28px var(--glow-primary),
      0 0 14px var(--glow-secondary),
      var(--neu-hover-outset);
  }

  /* Ensure focused node remains on top of tooltips/nodes */
  .constellation-node.focused {
    z-index: 1000 !important;
  }

  /* ── SVG Icon ── */
  .skill-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .skill-icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
    display: block;
  }

  /* ── Custom icon styles ── */

  /* PHP */
  .constellation-node[data-id="php"] .skill-icon {
    width: 32px;
    height: 32px;
  }
  .constellation-node[data-id="php"]:hover .skill-icon,
  .constellation-node[data-id="php"].focused .skill-icon {
    color: var(--brand-php);
  }
  /* Mysql */
  .constellation-node[data-id="mysql"] .skill-icon {
    width: 32px;
    height: 32px;
  }
  .constellation-node[data-id="mysql"]:hover .skill-icon,
  .constellation-node[data-id="mysql"].focused .skill-icon {
    color: var(--brand-mysql);
  }
  /* Symfony */
  :root:not([data-theme="dark"]) .constellation-node[data-id="symfony"]:hover .skill-icon,
  :root:not([data-theme="dark"]) .constellation-node[data-id="symfony"].focused .skill-icon {
    color: var(--brand-symfony-light);
  }
  :root[data-theme="dark"] .constellation-node[data-id="symfony"]:hover .skill-icon,
  :root[data-theme="dark"] .constellation-node[data-id="symfony"].focused .skill-icon {
