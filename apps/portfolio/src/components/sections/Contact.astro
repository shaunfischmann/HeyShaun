---
import type { Lang, Translations } from "../../i18n/utils";
import { getTranslations } from "../../i18n/utils";
import { Send, Copy, Check } from "@lucide/astro";

export interface Props {
  lang?: Lang;
  t?: Translations;
}

const { lang = "en" } = Astro.props;
const t = Astro.props.t || getTranslations(lang);
const contactEmail = import.meta.env.CONTACT_TO_EMAIL;

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/shaunfischmann",
    svg: `<svg role="img" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><title>GitHub</title><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/sfischmann/",
    svg: `<svg role="img" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><title>LinkedIn</title><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<footer id="contact" class="site-footer" aria-labelledby="contact-heading">
  <div class="container">
    <div class="footer-grid" data-reveal>
      <!-- Left Column: Section Header & Subtitle -->
      <div class="footer-left">
        <div class="contact-header section-header">
          <p class="section-tag" data-i18n="contact.tag">{t.contact.tag}</p>
          <h2 id="contact-heading" class="section-title">
            <span class="gradient-text" data-i18n="contact.heading"> {t.contact.heading} </span>
          </h2>
          <p class="contact-sub section-sub" data-i18n="contact.sub">
            {t.contact.sub}
          </p>

          <!-- Social Pills -->
          <ul class="social-row">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="social-pill btn btn--ghost glass-card"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                  >
                    <span class="social-icon" set:html={s.svg} />
                    <span class="social-label">{s.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right Column -->
      <div class="footer-right">
        <!-- Compound Email Pill Container -->
        <div class="email-btn-wrapper">
          <a href={`mailto:${contactEmail}`} class="btn btn--ghost email-main-btn">
            <Send size={18} class="mail-icon" aria-hidden="true" />
            <span class="email-text" id="email-address-text">{contactEmail}</span>
          </a>

          <!-- Integrated Copy Button -->
          <button
            type="button"
            class="inline-copy-btn"
            id="copy-email-btn"
            title={lang === "fr" ? "Copier l'adresse" : "Copy email"}
            aria-label={lang === "fr" ? "Copier l'adresse e-mail" : "Copy email address"}
          >
            <span class="copy-icon" aria-hidden="true"><Copy size={16} /></span>
            <span class="check-icon" hidden aria-hidden="true"><Check size={16} /></span>
          </button>

          <!-- Screen Reader Feedback -->
          <span id="copy-status" class="sr-only" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Banner -->
  <div class="footer-bottom">
    <p class="footer-copy">
      © {new Date().getFullYear()} Shaun Fischmann.
      <span data-i18n="footer.built">{t.footer?.built || "Built with ❤️"}</span>
      <a href={`/${lang}/credits`} class="footer-link" data-i18n="footer.credits"
        >{t.footer?.credits || " and some help"}</a
      >
      <span class="footer-sep" aria-hidden="true">•</span>
      <a href={`/${lang}/legal-notice`} class="footer-link" data-i18n="footer.legal_notice"
        >{t.footer?.legal_notice || "Legal Notice"}</a
      >
    </p>
  </div>

  <div class="waves-container">
    <svg
      class="waves"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      viewBox="0 20 150 50"
      preserveAspectRatio="none"
      shape-rendering="auto"
    >
      <defs>
        <path id="gentle-wave" d="M-160 44c30 0 58-6 88-6s 58 6 88 6 58-6 88-6 58 6 88 6 v44h-352z"></path>
      </defs>
      <g class="waves-parallax">
        <use xlink:href="#gentle-wave" x="48" y="0"></use>
        <use xlink:href="#gentle-wave" x="48" y="3"></use>
        <use xlink:href="#gentle-wave" x="48" y="5"></use>
        <use xlink:href="#gentle-wave" x="48" y="7"></use>
      </g>
    </svg>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const emailText = document.getElementById("email-address-text")?.textContent;
  const copyStatus = document.getElementById("copy-status");
  const copyIcon = copyBtn?.querySelector(".copy-icon") as HTMLElement | null;
  const checkIcon = copyBtn?.querySelector(".check-icon") as HTMLElement | null;
  const lang = window.location.pathname.split("/")[1] || "en";

  copyBtn?.addEventListener("click", async (e) => {
    e.preventDefault();

    if (!emailText) return;

    try {
      await navigator.clipboard.writeText(emailText);

      if (copyIcon && checkIcon) {
        copyIcon.hidden = true;
        checkIcon.hidden = false;
        copyBtn.classList.add("copied");

        if (copyStatus) {
          copyStatus.textContent = lang === "fr" ? "Adresse e-mail copiée !" : "Email address copied!";
        }

        setTimeout(() => {
          copyIcon.hidden = false;
          checkIcon.hidden = true;
          copyBtn.classList.remove("copied");
          if (copyStatus) copyStatus.textContent = "";
        }, 2000);
      }
    } catch (err) {
      console.error("Failed to copy email:", err);
    }
  });
</script>

<style>
  /* ── Footer Grid ── */
  .site-footer {
    padding-top: clamp(4rem, 8vw, 6rem);
    margin-top: 4rem;
    position: relative;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;

    @media (--md) {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  /* ── Left Column ── */
  .footer-left {
    display: flex;
    flex-direction: column;
  }

  .contact-header {
    margin-bottom: 0;
  }

  .site-footer h2 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin-bottom: 0.25rem;
  }

  /* ── Right Column ── */
  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    @media (--md) {
      align-items: flex-end;
    }
  }

  /* ── Compound Ghost Email Button Container ── */
  .email-btn-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    transition: transform var(--transition-spring);
  }

  .email-btn-wrapper:hover {
    transform: translateY(-3px);
  }

  .email-main-btn {
    padding-right: 3.25rem; /* Reserve space inside pill for the copy button */
  }

  /* Synchronize main pill hover state */
  .email-btn-wrapper:hover .email-main-btn {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    box-shadow: 0 8px 25px rgba(0, 206, 201, 0.2);
    transform: none; /* Prevent double-translation */
  }

  .email-main-btn .mail-icon {
    transition: transform var(--transition-spring);
  }

  .email-btn-wrapper:hover .email-main-btn .mail-icon {
    transform: translate(2px, -2px);
  }

  /* Embedded Copy Button */
  .inline-copy-btn {
    position: absolute;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 1px;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-full);
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text);
    cursor: pointer;
    z-index: 2;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .email-btn-wrapper .inline-copy-btn:hover {
    color: var(--color-secondary);
  }

  .inline-copy-btn:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-hover);
    color: var(--color-secondary) !important;
  }

  .inline-copy-btn.copied {
    color: var(--pastel-mint) !important;
    background: rgba(167, 243, 208, 0.15);
    border-color: rgba(167, 243, 208, 0.3);
  }

  /* Visually Hidden Utility for Screen Readers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Social Pills ── */
  .social-row {
    display: flex;
    margin-top: 1rem;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-pill {
    padding: 0.5rem 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      color var(--transition-fast),
      transform var(--transition-spring),
      border-color var(--transition-fast);
  }

  .social-pill:hover {
    color: var(--color-text);
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .social-icon {
    display: flex;
    align-items: center;
    color: var(--color-primary);
  }

  /* ── Copyright Banner ── */
  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
    text-align: center;
  }

  .footer-copy {
    padding: 0 2em;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .footer-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      text-decoration var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  .footer-sep {
    opacity: 0.6;
    margin: 0 0.35rem;
  }

  /* ── Waves Animation ── */
  .waves-container {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 300%;
    line-height: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;

    @media (--lg) {
      width: 100%;
    }
  }

  .waves {
    height: 100vh;
    min-height: 100px;
  }

  .waves-container .waves {
    position: relative;
    width: 100%;
    opacity: 0.5;
    display: block;
  }

  .waves-parallax > use {
    fill: var(--glass-bg);
    animation: 35s cubic-bezier(0.55, 0.5, 0.45, 0.5) 0s infinite reverse move-forever;
  }
  .waves-parallax > use:nth-child(1) {
    fill: var(--glow-primary);
    animation-delay: -2s;
    animation-duration: 11s;
  }
  .waves-parallax > use:nth-child(2) {
    fill: var(--glow-secondary);
    animation-delay: -3s;
    animation-duration: 15s;
  }
  .waves-parallax > use:nth-child(3) {
    fill: var(--glow-primary);
    animation-delay: -4s;
    animation-duration: 21s;
  }
  .waves-parallax > use:nth-child(4) {
    fill: var(--glow-secondary);
    animation-delay: -5s;
    animation-duration: 30s;
  }

  @keyframes move-forever {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }
</style>
