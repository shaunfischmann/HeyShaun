---
const socials = [
  {
    label: "GitHub",
    href: "https://github.com/shaunfischmann",
    svg: `<svg role="img" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><title>GitHub</title><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/sfischmann/",
    svg: `<svg role="img" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><title>LinkedIn</title><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<footer id="contact" class="site-footer" aria-labelledby="contact-heading">
  <div class="container">
    <div class="footer-grid" data-reveal>
      <!-- Left Column: Heading, Subtitle, Socials -->
      <div class="footer-left">
        <div class="contact-header section-header">
          <p class="section-tag" data-i18n="contact.tag">Let's Connect</p>
          <h2 id="contact-heading" class="section-title">
            <span class="gradient-text" data-i18n="contact.heading"> Say hello! </span>
          </h2>
          <p class="contact-sub section-sub" data-i18n="contact.sub">
            Whether you want to talk web development, PHP, Proptech, AI, or just connect — feel free to drop a message!
          </p>
        </div>

        <!-- Social Pills -->
        <div class="social-row" role="list">
          {
            socials.map((s) => (
              <a
                href={s.href}
                class="social-pill glass-card"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                role="listitem"
              >
                <span class="social-icon" set:html={s.svg} />
                <span class="social-label">{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Sleek Modern Glass Contact Form -->
      <div class="footer-right">
        <form class="sleek-contact-form" id="contact-form" novalidate>
          <div class="form-row">
            <div class="field-group">
              <label for="form-name" data-i18n="contact.label_name">Name</label>
              <div class="input-wrapper">
                <input
                  type="text"
                  id="form-name"
                  name="name"
                  required
                  placeholder="Your Name"
                  data-i18n-placeholder="contact.placeholder_name"
                  class="glass-input"
                />
                <span class="input-focus-line"></span>
              </div>
            </div>
            <div class="field-group">
              <label for="form-email" data-i18n="contact.label_email">Email</label>
              <div class="input-wrapper">
                <input
                  type="email"
                  id="form-email"
                  name="email"
                  required
                  placeholder="your.email@example.com"
                  data-i18n-placeholder="contact.placeholder_email"
                  class="glass-input"
                />
                <span class="input-focus-line"></span>
              </div>
            </div>
          </div>

          <div class="field-group">
            <label for="form-subject" data-i18n="contact.label_subject">Subject</label>
            <div class="input-wrapper">
              <input
                type="text"
                id="form-subject"
                name="subject"
                placeholder="Project Inquiry / Hello"
                data-i18n-placeholder="contact.placeholder_subject"
                class="glass-input"
              />
              <span class="input-focus-line"></span>
            </div>
          </div>

          <div class="field-group">
            <label for="form-message" data-i18n="contact.label_message">Message</label>
            <div class="input-wrapper">
              <textarea
                id="form-message"
                name="message"
                rows="4"
                required
                placeholder="Tell me about your project or message..."
                data-i18n-placeholder="contact.placeholder_message"
                class="glass-input glass-textarea"></textarea>
              <span class="input-focus-line"></span>
            </div>
          </div>

          <!-- Anti-spam honeypot -->
          <input
            type="text"
            name="_honeypot"
            class="honeypot-field"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit" class="submit-btn" id="contact-submit" aria-label="Send message">
            <span class="submit-text" data-i18n="contact.submit">Send Message</span>
            <span class="submit-icon send-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </span>
            <span class="submit-icon check-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
          </button>

          <div class="form-feedback" id="form-feedback" hidden aria-live="polite"></div>
        </form>
      </div>
    </div>

    <!-- Copyright Banner -->
    <div class="footer-bottom">
      <p class="footer-copy">
        © {new Date().getFullYear()} Shaun Fischmann.
        <span data-i18n="contact.footer">Built by Shaun, with the help of...</span>
      </p>
    </div>
  </div>

  <div class="waves-container">
    <svg
      class="waves"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      viewBox="0 20 150 50"
      preserveAspectRatio="none"
      shape-rendering="auto"
    >
      <defs>
        <!-- <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path> -->
        <path id="gentle-wave" d="M-160 44c30 0 58-6 88-6s 58 6 88 6 58-6 88-6 58 6 88 6 v44h-352z"></path>
      </defs>
      <g class="waves-parallax">
        <use xlink:href="#gentle-wave" x="48" y="0"></use>
        <use xlink:href="#gentle-wave" x="48" y="3"></use>
        <use xlink:href="#gentle-wave" x="48" y="5"></use>
        <use xlink:href="#gentle-wave" x="48" y="7"></use>
      </g>
    </svg>
  </div>
</footer>

<style>
  /* ── Footer ── */
  .site-footer {
    padding-top: clamp(4rem, 8vw, 6rem);
    margin-top: 4rem;
    position: relative;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* ── Left Column ── */
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 0.25rem;
  }

  .contact-sub {
    font-family: var(--font-body);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    max-width: 460px;
  }

  /* Social Pills */
  .social-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      transform var(--transition-spring),
      border-color var(--transition-fast),
      box-shadow var(--transition-base);
  }

  .social-pill:hover {
    color: var(--color-text);
    border-color: var(--color-primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px var(--glow-primary);
  }

  .social-icon {
    display: flex;
    align-items: center;
    color: var(--color-primary);
  }

  /* ── Right Column: Sleek Glass Contact Form ── */
  .footer-right {
    width: 100%;
  }

  .sleek-contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 540px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-group label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .input-wrapper {
    position: relative;
    width: 100%;
  }

  /* Sleek Modern Liquid Glass Inputs */
  .glass-input {
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.875rem;
    outline: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
    -webkit-appearance: none;
  }

  .glass-input::placeholder {
    color: var(--color-text-faint);
  }

  .glass-input:hover {
    border-color: var(--color-primary);
  }

  .glass-input:focus {
    border-color: var(--color-primary);
    background: var(--color-surface);
    box-shadow: 0 0 0 3px var(--glow-primary);
  }

  .glass-textarea {
    resize: vertical;
    min-height: 100px;
  }

  /* Animated focus line indicator under input */
  .input-focus-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    transition:
      width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 2px;
    pointer-events: none;
  }

  .glass-input:focus + .input-focus-line {
    width: 100%;
    left: 0;
  }

  .honeypot-field {
    display: none !important;
    position: absolute;
    left: -9999px;
  }

  /* ── Submit Button ── */
  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px -4px var(--glow-primary);
    transition:
      transform var(--transition-spring),
      box-shadow var(--transition-base),
      opacity var(--transition-fast);
    margin-top: 0.25rem;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px -4px var(--glow-primary);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .submit-icon {
    display: flex;
    align-items: center;
    transition: all var(--transition-spring);
  }

  .check-icon {
    position: absolute;
    right: 1.25rem;
    opacity: 0;
    transform: scale(0.5) rotate(-45deg);
  }

  .submit-btn.success .send-icon {
    opacity: 0;
    transform: scale(0.5) translateX(1rem);
  }

  .submit-btn.success .check-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .submit-btn.success {
    background: linear-gradient(135deg, #00cec9, #00b09b);
    box-shadow: 0 8px 24px -4px rgba(0, 206, 201, 0.45);
  }

  /* Feedback message */
  .form-feedback {
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    background: rgba(0, 206, 201, 0.1);
    border: 1px solid rgba(0, 206, 201, 0.3);
    color: var(--color-text);
  }

  /* ── Copyright Banner ── */
  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    text-align: center;
  }

  .footer-copy {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* ── Waves Animation ── */
  .waves-container {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  @media (min-width: 1180px) {
    .waves-container {
      left: calc(-1 * clamp(100px, 10vw, 150px));
      width: calc(100% + clamp(100px, 10vw, 150px));
    }
  }

  .waves-container .waves {
    position: relative;
    width: 100%;
    height: 100vh;
    margin-bottom: -7px; /*Fix for safari gap*/
    min-height: 100px;
    opacity: 0.5;
    display: block;
  }
  .waves-parallax > use {
    fill: var(--glass-bg);
    /* @keyframes duration | timing-function | delay | iteration-count | direction | name */
    animation: 35s cubic-bezier(0.55, 0.5, 0.45, 0.5) 0s infinite reverse move-forever;
  }
  .waves-parallax > use:nth-child(1) {
    fill: var(--glow-primary);
    animation-delay: -2s;
    animation-duration: 11s;
  }
  .waves-parallax > use:nth-child(2) {
    fill: var(--glow-secondary);
    animation-delay: -3s;
    animation-duration: 15s;
  }
  .waves-parallax > use:nth-child(3) {
    fill: var(--glow-primary);
    animation-delay: -4s;
    animation-duration: 21s;
  }
  .waves-parallax > use:nth-child(4) {
    fill: var(--glow-secondary);
    animation-delay: -5s;
    animation-duration: 30s;
  }
  @keyframes move-forever {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }
  /*Shrinking for mobile*/
  @media (max-width: 768px) {
    .waves {
      height: 40px;
      min-height: 40px;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 868px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const feedback = document.getElementById("form-feedback");
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    if (formData.get("_honeypot")) return;

    submitBtn?.setAttribute("disabled", "true");

    setTimeout(() => {
      submitBtn?.classList.add("success");

      if (feedback) {
        feedback.removeAttribute("hidden");
        feedback.className = "form-feedback success";
        const lang = localStorage.getItem("lang") || "en";
        feedback.textContent =
          lang === "fr" ? "✨ Merci ! Votre message a bien été reçu." : "✨ Thank you! Your message has been received.";
      }

      form.reset();

      setTimeout(() => {
        submitBtn?.classList.remove("success");
        submitBtn?.removeAttribute("disabled");
      }, 3000);
    }, 500);
  });
</script>
