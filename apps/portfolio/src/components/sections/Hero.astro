---
import darkShaun from "../../assets/avatar/dark-shaun-transparent.png";
import lightShaun from "../../assets/avatar/light-shaun-transparent.png";
import { Send, ArrowUpRight } from "@lucide/astro";
import type { Lang, Translations } from "../../i18n/utils";
import { getTranslations } from "../../i18n/utils";

export interface Props {
  lang?: Lang;
  t?: Translations;
}

const { lang = "en" } = Astro.props;
const t = Astro.props.t || getTranslations(lang);
---

<section id="hero" class="hero" aria-label="Introduction" data-lang={lang}>
  <!-- Monumental Stage: backdrop name + portrait -->
  <div class="hero-stage">
    <!-- Giant Background Typography -->
    <div class="hero-backdrop" id="hero-backdrop" aria-hidden="true">
      <span class="hero-backdrop-greeting" data-i18n="hero.greeting">{t.hero.greeting}</span>
      <div class="hero-backdrop-row hero-backdrop-row--shaun">
        <span>S</span><span>H</span><span>A</span><span>U</span><span>N</span>
      </div>
      <div class="hero-backdrop-row hero-backdrop-row--fischmann">
        <span>F</span><span>I</span><span>S</span><span>C</span><span>H</span><span>M</span><span>A</span><span>N</span
        ><span>N</span>
      </div>
    </div>

    <!-- Full-Size Portrait -->
    <div class="portrait" id="hero-portrait">
      <!-- Ambient glow orbs -->
      <div class="portrait-orbs" aria-hidden="true">
        <div class="portrait-orb portrait-orb--magenta"></div>
        <div class="portrait-orb portrait-orb--cyan"></div>
        <div class="portrait-orb portrait-orb--mauve"></div>
      </div>
      <div class="portrait-mask">
        <img
          src={lightShaun.src}
          alt={t.hero.aria_portrait}
          width="760"
          height="920"
          loading="eager"
          fetchpriority="high"
          class="portrait-img portrait-img--light"
        />
        <img
          src={darkShaun.src}
          alt={t.hero.aria_portrait}
          width="760"
          height="920"
          loading="eager"
          fetchpriority="high"
          class="portrait-img portrait-img--dark"
        />
      </div>
    </div>
  </div>

  <!-- Editorial Footer -->
  <div class="container">
    <div class="hero-footer" data-reveal>
      <div class="hero-bio">
        <div class="hero-typing" aria-hidden="true">
          <span class="hero-typing-prefix">&gt;</span>
          <span class="hero-typing-text" id="typing-text"></span>
          <span class="hero-typing-cursor"></span>
        </div>
        <p class="hero-bio-text" data-i18n="hero.subtitle" set:html={t.hero.subtitle} />
      </div>

      <div class="hero-actions">
        <a href={`/${lang}/#contact`} class="btn btn--primary" id="hero-contact-btn">
          <span data-i18n="hero.cta_contact">{t.hero.cta_contact}</span>
          <Send size={18} stroke-width={2.2} />
        </a>
        <a href={`/${lang}/shaun-ai-gallery`} class="btn btn--ghost" id="hero-art-btn">
          <span data-i18n="hero.cta_gallery">{t.hero.cta_gallery}</span>
          <ArrowUpRight size={18} stroke-width={2.2} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Hero Section ───────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100dvh;
    height: 100dvh;
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: clamp(2.5rem, 5vh, 3.75rem);
    padding-bottom: clamp(0.75rem, 1.8vh, 1.25rem);
    overflow: hidden;
    background: transparent;
  }

  /* ── Typing ────────────────────────────────────────────────── */
  .hero-typing {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text);
    font-family: var(--font-code);
    font-size: clamp(0.8rem, 0.9vw, 1rem);
  }

  .hero-typing-prefix {
    color: var(--color-primary);
  }

  .hero-typing-text {
    color: var(--color-text);
  }

  .hero-typing-cursor {
    display: inline-block;
    width: 6px;
    height: 1.1em;
    background: var(--color-secondary);
    animation: cursor-blink 0.9s step-end infinite;
  }

  @keyframes cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* ── Stage ──────────────────────────────────────────────────── */
  .hero-stage {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 0;
    margin: 0;
  }

  /* ── Backdrop Name ──────────────────────────────────────────── */
  .hero-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 0.88;
    text-align: center;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-backdrop-greeting {
    font-family: var(--font-script);
    font-size: clamp(0.875rem, min(2.5vw, 3.5vh), 2rem);
    font-weight: 700;
    color: var(--color-secondary);
    align-self: flex-start;
    letter-spacing: 0.02em;
    transform: rotate(-6deg) translateY(18%) translateX(-12%);
    text-shadow: 0 0 20px rgba(0, 206, 201, 0.35);
    z-index: 2;
    display: inline-block;
  }

  [data-theme="light"] .hero-backdrop-greeting {
    color: var(--color-primary);
    text-shadow: 0 0 16px rgba(108, 92, 231, 0.25);
  }

  .hero-backdrop-row {
    font-family: var(--font-hero);
    letter-spacing: clamp(0.03em, 0.06em, 0.09em);
    text-transform: uppercase;
    white-space: nowrap;
    display: flex;
    justify-content: center;
    max-width: 100%;
  }

  .hero-backdrop-row--shaun {
    font-size: clamp(3.5rem, min(17vw, 19vh), 15rem);
    transform: translateY(3%);
  }

  .hero-backdrop-row--fischmann {
    font-size: clamp(1.85rem, min(9.5vw, 10.8vh), 8.4rem);
    transform: translateY(-3%);
  }

  .hero-backdrop-row span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  /* ── Portrait ───────────────────────────────────────────────── */
  .portrait {
    position: relative;
    z-index: 2;
    width: clamp(380px, 68vw, 980px);
    height: 100%;
    max-height: clamp(380px, 63vh, 760px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portrait-mask {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 0%, black 80%, transparent 98%);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    transition: transform 0.4s ease;
  }

  .portrait-img--light {
    display: block;
  }
  .portrait-img--dark {
    display: none;
  }

  :global([data-theme="dark"]) .portrait-img--light {
    display: none;
  }
  :global([data-theme="dark"]) .portrait-img--dark {
    display: block;
  }

  /* ── Orbs ───────────────────────────────────────────────────── */
  .portrait-orbs {
    position: absolute;
    inset: -35px;
    z-index: 1;
    pointer-events: none;
  }

  .portrait-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.45;
  }

  .portrait-orb--magenta {
    top: -5%;
    left: -15%;
    width: 182px;
    height: 182px;
    background: radial-gradient(circle, #e84393 0%, rgba(232, 67, 147, 0) 70%);
    transform: scale(1.43);
    transform-origin: top left;
    animation: orb-drift-1 28s ease-in-out infinite alternate;
  }

  .portrait-orb--cyan {
    bottom: 0%;
    right: -15%;
    width: 196px;
    height: 196px;
    background: radial-gradient(circle, #00cec9 0%, rgba(0, 206, 201, 0) 70%);
    transform: scale(1.43);
    transform-origin: bottom right;
    animation: orb-drift-2 34s ease-in-out infinite alternate;
  }

  .portrait-orb--mauve {
    top: 30%;
    left: 20%;
    width: 210px;
    height: 210px;
    background: radial-gradient(circle, #6c5ce7 0%, rgba(108, 92, 231, 0) 70%);
    transform: scale(1.43);
    transform-origin: top left;
    animation: orb-drift-3 30s ease-in-out infinite alternate;
  }

  @keyframes orb-drift-1 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(16px, 22px) scale(1.05);
    }
    100% {
      transform: translate(-12px, 10px) scale(0.95);
    }
  }

  @keyframes orb-drift-2 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-22px, -18px) scale(1.04);
    }
    100% {
      transform: translate(14px, -10px) scale(0.97);
    }
  }

  @keyframes orb-drift-3 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-15px, 20px) scale(0.94);
    }
    100% {
      transform: translate(20px, -14px) scale(1.06);
    }
  }

  /* Mobile: orbs are a battery drain */
  @media (max-width: 768px) {
    .portrait-orbs {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .portrait-orb--magenta,
    .portrait-orb--cyan,
    .portrait-orb--mauve {
      animation: none !important;
    }
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .hero-footer {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: end;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);

    @media (min-width: 900px) {
      grid-template-columns: 1.3fr 0.9fr;
      gap: 3rem;
    }
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  .hero-bio-eyebrow {
    font-family: var(--font-code);
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    font-weight: 600;
    color: var(--color-secondary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-bio-name {
    color: var(--color-text);
    font-weight: 700;
  }

  .hero-bio-text {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 640px;
    margin: 0;
  }

  .hero-bio-text :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    width: 100%;

    @media (min-width: 900px) {
      justify-content: flex-end;
    }
  }

  /* ── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero-stage {
      min-height: clamp(280px, 45vh, 420px);
      margin-bottom: 0.5rem;
    }

    .hero-backdrop-greeting {
      font-size: clamp(0.8rem, min(4vw, 3vh), 1.25rem);
      padding-left: clamp(0.75rem, 5vw, 2.5rem);
      margin-bottom: 0.25rem;
    }

    .hero-backdrop-row--shaun {
      font-size: clamp(2.5rem, min(16vw, 13vh), 5rem);
    }

    .hero-backdrop-row--fischmann {
      font-size: clamp(1.4rem, min(9.2vw, 7.5vh), 2.9rem);
    }

    .portrait {
      width: clamp(280px, 86vw, 460px);
      height: clamp(300px, 46vh, 440px);
    }

    .hero-actions {
      flex-direction: column;
    }
  }

  /* ── Reduced Motion ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-backdrop,
    .portrait {
      transform: none !important;
    }
  }
</style>

<script>
  const heroSection = document.getElementById("hero");
  const heroBackdrop = document.getElementById("hero-backdrop");
  const portrait = document.getElementById("hero-portrait");
  const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Cinematic Mouse Parallax ──────────────────────────────────
  let targetX = 0,
    targetY = 0;
  let currentBgX = 0,
    currentBgY = 0;
  let currentPortX = 0,
    currentPortY = 0;
  let isHovering = false;

  if (heroSection && !isReduced && window.innerWidth > 768) {
    heroSection.addEventListener("mousemove", (e) => {
      const { left, top, width, height } = heroSection.getBoundingClientRect();
      targetX = (e.clientX - left) / width - 0.5;
      targetY = (e.clientY - top) / height - 0.5;
      isHovering = true;
    });

    heroSection.addEventListener("mouseleave", () => {
      targetX = 0;
      targetY = 0;
      isHovering = false;
    });

    function renderLoop() {
      if (!isHovering && Math.abs(currentBgX) < 0.05 && Math.abs(currentBgY) < 0.05) {
        requestAnimationFrame(renderLoop);
        return;
      }
      const destBgX = targetX * -30,
        destBgY = targetY * -20;
      const destPortX = targetX * 22,
        destPortY = targetY * 12;

      currentBgX += (destBgX - currentBgX) * 0.07;
      currentBgY += (destBgY - currentBgY) * 0.07;
      currentPortX += (destPortX - currentPortX) * 0.07;
      currentPortY += (destPortY - currentPortY) * 0.07;

      if (heroBackdrop)
        heroBackdrop.style.transform = `translate(calc(-50% + ${currentBgX.toFixed(2)}px), calc(-50% + ${currentBgY.toFixed(2)}px))`;

      requestAnimationFrame(renderLoop);
    }
    requestAnimationFrame(renderLoop);
  }

  // ── Scroll Parallax ───────────────────────────────────────────
  window.addEventListener(
    "scroll",
    () => {
      if (!heroSection || isReduced) return;
      const scrollY = window.scrollY;
      const heroHeight = heroSection.offsetHeight || 700;
      const progress = Math.min(scrollY / (heroHeight * 0.75), 1);

      if (portrait) {
        portrait.style.opacity = Math.max(1 - progress * 1.3, 0).toFixed(3);
        portrait.style.transform = `translate3d(0, ${(scrollY * 0.18).toFixed(2)}px, 0)`;
      }
    },
    { passive: true },
  );

  // ── Typing Effect ─────────────────────────────────────────────
  const phrases: Record<string, string[]> = {
    en: [
      "Partnership Manager @ Apimo",
      "Senior PHP Developer",
      "12+ Years in PropTech & CRM",
      "AI Enthusiast @ Shaun.AI",
      "Enjoying an ice cold coffee ☕️",
    ],
    fr: [
      "Partnership Manager @ Apimo",
      "Développeur PHP Senior",
      "12+ ans en PropTech & CRM",
      "Passionné d'IA @ Shaun.AI",
      "Savourant un café glacé ☕️",
    ],
  };

  const typingEl = document.getElementById("typing-text");
  if (typingEl) {
    const heroSec = document.getElementById("hero");
    let lang = (heroSec?.getAttribute("data-lang") || document.documentElement.lang || "en") as keyof typeof phrases;
    let phraseIdx = 0,
      charIdx = 0,
      deleting = false;

    function tick() {
      lang = (heroSec?.getAttribute("data-lang") || document.documentElement.lang || "en") as keyof typeof phrases;
      const list = phrases[lang] || phrases["en"];
      const phrase = list[phraseIdx % list.length];

      if (!deleting) {
        charIdx++;
        typingEl.textContent = phrase.slice(0, charIdx);
        if (charIdx >= phrase.length) {
          deleting = true;
          window.setTimeout(tick, 2200);
          return;
        }
        window.setTimeout(tick, 55);
      } else {
        charIdx--;
        typingEl.textContent = phrase.slice(0, charIdx);
        if (charIdx === 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % list.length;
          window.setTimeout(tick, 350);
          return;
        }
        window.setTimeout(tick, 25);
      }
    }
    window.setTimeout(tick, 600);
  }
</script>
