{
  "$schema": "https://v2-10-11.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "portfolio#build": {
      "dependsOn": ["^build", "design-tokens#build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "design-tokens#build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
