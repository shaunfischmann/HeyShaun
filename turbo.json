{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "portfolio#build": {
      "dependsOn": ["^build", "ui#build", "design-tokens#build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "ui#build": {
      "outputs": ["dist/**"]
    },
    "design-tokens#build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
